@{
    ViewData["Title"] = "Perfil";
    string fotoRuta = ((string?)ViewBag.FotoPerfil ?? "").Trim();
    bool tieneFotoPropia = !string.IsNullOrWhiteSpace(fotoRuta) && !fotoRuta.EndsWith("user.svg", StringComparison.OrdinalIgnoreCase);
    string fotoUrl = !string.IsNullOrWhiteSpace(fotoRuta)
        ? (fotoRuta.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? fotoRuta
            : Url.Content("~/" + fotoRuta.TrimStart('~', '/')))
        : Url.Content("~/img/user.svg");
}

<main class="auth-page">
    <section class="auth-card auth-card--narrow">
        <h1 class="auth-title">Perfil de usuario</h1>
        <div class="auth-divider"></div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="auth-alert" style="background-color: #d4edda; color: #155724; border-color: #c3e6cb;">
                @ViewBag.SuccessMessage
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="auth-alert">
                @ViewBag.ErrorMessage
            </div>
        }

        <div class="text-center" style="margin-bottom: 18px;">
            @if (!string.IsNullOrWhiteSpace(fotoRuta))
            {
                <img class="profile-photo" src="@fotoUrl" alt="Foto de perfil" />
            }
            else
            {
                <div class="profile-photo profile-photo--empty">Sin foto</div>
            }

            <form action='@Url.Action("ActualizarFotoPerfil", "Home")' method="post" enctype="multipart/form-data" style="margin-top: 12px; display: flex; flex-direction: column; align-items: center; gap: 8px;">
                <div class="field upload-field" style="margin: 0; align-items: center;">
                    <label class="upload-button" for="FotoPerfilActualizar" data-file-label="FotoPerfilActualizar" title="Seleccionar nueva foto de perfil" style="cursor: pointer;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="upload-icon">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                    </label>
                    <input type="file" id="FotoPerfilActualizar" name="FotoPerfil" accept="image/*" onchange="this.form.submit()" />
                    <span class="upload-filename" data-file-name="FotoPerfilActualizar">Cambiar foto de perfil</span>
                </div>
            </form>
        </div>

        <div class="auth-note">
            <p><strong>Nombre:</strong> @ViewBag.Nombre</p>
            <p><strong>Apellido:</strong> @ViewBag.Apellido</p>
            <p><strong>Email:</strong> @ViewBag.Email</p>
            <p><strong>Provincia:</strong> @ViewBag.Provincia</p>
            <p><strong>Calle:</strong> @ViewBag.Calle</p>
            <p><strong>Dirección:</strong> @ViewBag.Direccion</p>
            <p><strong>Código postal:</strong> @ViewBag.CodigoPostal</p>
            <p><strong>Tipo de usuario:</strong> @ViewBag.TipoUsuario</p>
        </div>

        <div class="auth-actions" style="gap: 12px;">
            @if (ViewBag.EsJoven == true)
            {
                <a class="auth-button auth-button--secondary" href='@Url.Action("PrincipalJoven", "Home")'>Ir al inicio</a>
            }
            else
            {
                <a class="auth-button auth-button--secondary" href='@Url.Action("PrincipalAdulto", "Home")'>Ir al inicio</a>
            }
            <a class="auth-button" href='@Url.Action("CerrarSesion", "Home")'>Cerrar sesión</a>
        </div>
    </section>
</main>
