@{
    ViewData["Title"] = "Inicio Joven";
}

<header class="header">
    <a class="logo" href='@Url.Action("PrincipalJoven", "Home")'>
        <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
    </a>

    <button class="menu-toggle"
            aria-expanded="false"
            aria-controls="navigation"
            aria-label="Abrir menú">
        ☰
    </button>

        <nav id="navigation" aria-label="Navegación principal">
            <a class="nav-button nav-button--joven" href='@Url.Action("Explorar", "Home")'>
                Explorá
            </a>

        <a class="nav-button" href='@Url.Action("Index", "Home")#preguntas'>
            Preguntas frecuentes
        </a>

        <a class="nav-button" href='@Url.Action("RegistroJoven", "Home")'>
            Trabajá con nosotros
        </a>

        <a class="nav-button nav-help" href='@Url.Action("SolicitarTarea", "Home")'>
            Solicita tus ayudas
        </a>

        <a class="nav-button login" href='@Url.Action("Perfil", "Home")'>
            <img class="login-icon" src="~/img/user.svg" alt="" />
            Mi cuenta
        </a>
    </nav>
</header>

<main class="page" id="explorar">
    <section class="panel seccion-explorar-mapa">
        <h2>Mapa de nuestra comunidad</h2>
        <div class="contenedor-mapa-zona">
            <iframe
                class="mapa-ubicacion-iframe"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13136.068307238214!2d-58.4418!3d-34.5912!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bcca0d6c4a5bb7%3A0x247a3e5c92c7d9c6!2sVilla%20Crespo%2C%20Buenos%20Aires!5e0!3m2!1ses!2sar!4v1700000000000"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>
    </section>

    <main class="joven-main">
        <section class="joven-seccion">
            <h2>¿Que necesitás hacer?</h2>

            <div class="joven-acciones-grid">
                <a class="joven-accion-item" href='@Url.Action("AyudasParaRealizar", "Home")'>
                    <div class="joven-accion-Verde">
                        <div class="joven-accion-Blanco">
                            <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#115e2e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="5" y="3" width="14" height="18" rx="2" ry="2"></rect>
                                <path d="M9 3h6v3H9z"></path>
                                <path d="M8 10l1.5 1.5L12 9"></path>
                                <line x1="14" y1="10" x2="16" y2="10"></line>
                                <path d="M8 15l1.5 1.5L12 14"></path>
                                <line x1="14" y1="15" x2="16" y2="15"></line>
                            </svg>
                        </div>
                    </div>
                    <p>Realiza una  <strong>Ayuda</strong></p>
                </a>

                <a class="joven-accion-item" href="#ultimas-actividades">
                    <div class="joven-accion-Verde">
                        <div class="joven-accion-Blanco">
                            <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="#115e2e">
                                <path d="M12 3C6.5 3 2 6.6 2 11c0 2.1 1 4.1 2.7 5.5L3.5 20l3.8-1.5c1.4.5 3 .8 4.7.8 5.5 0 10-3.6 10-8.3S17.5 3 12 3zm-4 9a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4zm4 0a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4zm4 0a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4z"/>
                            </svg>
                        </div>
                    </div>
                    <p>Ver <strong>conversaciones</strong></p>
                </a>

                <a class="joven-accion-item" href="#ultimas-actividades">
                    <div class="joven-accion-Verde">
                        <div class="joven-accion-Blanco">
                            <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="#115e2e">
                                <path d="M12 22c1.1 0 2-.9 2-2h-4a2 2 0 0 0 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/>
                            </svg>
                        </div>
                    </div>
                    <p>Ver <strong>notificaciones</strong></p>
                </a>
            </div>
        </div>
    </section>

    <section class="panel seccion-ultimos-ayudados">
        <h2>Tareas solicitadas por adultos</h2>
        <div class="contenedor-lista-ayudados">
            @{
                List<Tareas>? tareasDisponibles = ViewBag.TareasDisponibles as List<Tareas>;
            }
            @if (tareasDisponibles != null && tareasDisponibles.Count > 0)
            {
                foreach (Tareas tarea in tareasDisponibles)
                {
                    DateTime fechaMostrar = tarea.DiaFecha.Year > 1 ? tarea.DiaFecha : (tarea.DiaTarea.Year > 1 ? tarea.DiaTarea : tarea.FechaCreacion);
                    <div class="item-tarjeta-ayudado">
                        <div class="ayudado-info-usuario" style="text-align: left; display: block;">
                            <span class="nombre-usuario-ayudado">@tarea.Titulo</span>
                            <p style="font-size: 14px; margin-top: 4px;">@tarea.Descripcion</p>
                            <p style="font-size: 13px; color: #555; margin-top: 4px;">
                                Lugar: @tarea.Lugar · Fecha: @fechaMostrar.ToString("dd/MM/yyyy")
                                @if (!string.IsNullOrEmpty(tarea.Aclaracion))
                                {
                                    <span> · @tarea.Aclaracion</span>
                                }
                            </p>
                        </div>
                        <div class="ayudado-acciones">
                            <button type="button" class="button" onclick="verInfoAyudado(@tarea.IdUsuarioSolicitante)">Ver solicitante</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="item-tarjeta-ayudado">
                    <span class="nombre-usuario-ayudado">Aún no hay tareas solicitadas disponibles.</span>
                </div>
            }
        </div>
    </section>

    <section class="panel seccion-ultimos-ayudados">
        <h2>Últimos ayudados</h2>
        <div class="contenedor-lista-ayudados">
            @{
                List<Usuarios>? listaAyudados = ViewBag.UltimosAyudados as List<Usuarios>;
            }
            @if (listaAyudados != null && listaAyudados.Count > 0)
            {
                int posicion = 1;
                foreach (Usuarios adulto in listaAyudados)
                {
                    string rutaFotoAdulto = adulto.FotoPerfil ?? "";
                    string srcAdulto = string.IsNullOrEmpty(rutaFotoAdulto)
                        ? Url.Content("~/img/user.svg")
                        : Url.Content("~" + rutaFotoAdulto);
                    string nombreAdulto = ((adulto.Nombre ?? "") + " " + (adulto.Apellido ?? "")).Trim();
                    if (string.IsNullOrEmpty(nombreAdulto))
                    {
                        nombreAdulto = adulto.Email ?? "Adulto mayor";
                    }

                    <div class="item-tarjeta-ayudado">
                        <div class="ayudado-info-usuario">
                            <img src="@srcAdulto" alt="@nombreAdulto" class="imagen-avatar-ayudado" />
                            <span class="nombre-usuario-ayudado">@nombreAdulto</span>
                        </div>
                        <div class="ayudado-acciones">
                            <button type="button" class="button" onclick="verInfoAyudado(@adulto.IdUsuario)">Ver más info</button>
                            <span class="posicion-ranking-numero">#@posicion</span>
                        </div>
                    </div>
                    posicion++;
                }
            }
            else
            {
                <div class="item-tarjeta-ayudado">
                    <span class="nombre-usuario-ayudado">Aún no se registran adultos ayudados.</span>
                </div>
            }
        </div>

        <div id="contenedorDetalleFetch" class="detalle-fetch-card" style="display: none;">
            <h3 id="detalleNombre"></h3>
            <p id="detalleEmail"></p>
            <p id="detalleTelefono"></p>
            <p id="detalleTipo"></p>
        </div>
    </section>
</main>

<footer>
    <div class="footer-content page">
        <a class="logo" href='@Url.Action("Index", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <div>
            <h3>Te Ayudo</h3>
            <a href='@Url.Action("Index", "Home")#nosotros'>Nuestra historia</a>
            <a href='@Url.Action("Index", "Home")#valores'>Nuestros valores</a>
        </div>

        <div>
            <h3>Explorá</h3>
            <a href='@Url.Action("PrincipalJoven", "Home")'>Mapa y comunidad</a>
            <a href='@Url.Action("Index", "Home")#como-funciona'>Cómo funciona</a>
            <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
        </div>

        <div>
            <h3>Trabajá con nosotros</h3>
            <a href='@Url.Action("Index", "Home")#trabaja'>Conocé la propuesta</a>
            <a href='@Url.Action("RegistroJoven", "Home")'>
                Sumate
            </a>
        </div>

        <div>
            <h3>Ayuda</h3>
            <a href='@Url.Action("Index", "Home")#preguntas'>Preguntas frecuentes</a>
            <a href='@Url.Action("Perfil", "Home")'>
                Mi cuenta
            </a>
        </div>
    </div>

    <p class="copyright">
        © <span id="year">2026</span> Te Ayudo.
        Todos los derechos reservados.
    </p>
</footer>
