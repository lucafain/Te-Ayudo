@{
    ViewData["Title"] = "Login";
}
<main class="auth-page">
    <section class="auth-card auth-card--narrow">
        <h1 class="auth-title">Iniciar sesión</h1>
        <div class="auth-divider"></div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="auth-alert">@ViewBag.SuccessMessage</div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="auth-alert">@ViewBag.ErrorMessage</div>
        }

        <div id="mensajeErrorJs" class="auth-alert" style="display: none;"></div>

        <form action='@Url.Action("Login", "Home")' method="post" id="formLogin">
            <div class="auth-grid" style="grid-template-columns: 1fr; gap: 16px;">
                <div class="field">
                    <label for="Email">Correo electrónico</label>
                    <input type="email" id="Email" name="Email" autocomplete="email" />
                </div>

                <div class="field">
                    <label for="Contrasena">Contraseña</label>
                    <input type="password" id="Contrasena" name="Contrasena" autocomplete="current-password" />
                </div>
            </div>

            <div class="auth-actions">
                <a class="auth-button auth-button--secondary" href='@Url.Action("Index", "Home")'>Volver al inicio</a>
                <button class="auth-button" type="submit">Iniciar sesión</button>
            </div>

            <div class="auth-links">
                Todavía no tenés una cuenta? <a href='@Url.Action("RegistroMayor", "Home")'>Registrarse</a>
                · <a href='@Url.Action("RegistroJoven", "Home")'>Trabajá con nosotros</a>
                · <a href='@Url.Action("OlvideContrasena", "Home")'>Olvidé mi contraseña</a>
            </div>
        </form>
    </section>
</main>
