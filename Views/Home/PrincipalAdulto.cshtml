@{
    ViewData["Title"] = "Inicio Adulto";
    string nombreAdulto = ((ViewBag.Adulto?.Nombre ?? "") + " " + (ViewBag.Adulto?.Apellido ?? "")).Trim();
    if (string.IsNullOrEmpty(nombreAdulto))
    {
        nombreAdulto = ViewBag.Adulto?.Email ?? "Usuario";
    }
}

<div class="joven-page">
    <header class="header header--joven">
        <a class="logo" href='@Url.Action("PrincipalAdulto", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <button class="menu-toggle"
                aria-expanded="false"
                aria-controls="navigation"
                aria-label="Abrir menú">
            ☰
        </button>

        <nav id="navigation" aria-label="Navegación principal">
            <a class="nav-button nav-button--joven" href='@Url.Action("Explorar", "Home")'>
                Explorá
            </a>

            <a class="nav-button nav-button--joven" href="#preguntas-adulto">
                Preguntas frecuentes
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("SolicitarTarea", "Home")'>
                Solicitá ayudas
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("Perfil", "Home")'>
                Perfil
            </a>
        </nav>
    </header>

    <section class="adulto-hero">
        <div class="joven-hero-overlay">
            <div class="joven-hero-content">
                <h1>Hola, @nombreAdulto</h1>
                <p class="adulto-hero-subtexto">Recibí asistencia a un monto accesible</p>
                <p class="adulto-hero-subtexto">Ayudá a un joven a adquirir experiencia laboral</p>
                <a class="joven-btn-ayuda" href='@Url.Action("SolicitarTarea", "Home")'>
                    Solicitá una Ayuda
                </a>
            </div>
        </div>
    </section>

    <main class="joven-main">
        <section class="joven-seccion">
            <h2>¿Qué necesitás hacer?</h2>

            <div class="adulto-acciones-grid">
                <a class="adulto-accion-card" href='@Url.Action("MisAyudas", "Home")'>
                    <div class="adulto-accion-blanco">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#115e2e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <p>Solicitar<br /><strong>ayudas</strong></p>
                </a>

                <a class="adulto-accion-card" href="#preguntas-adulto">
                    <div class="adulto-accion-blanco">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#115e2e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                    </div>
                    <p>Ver<br /><strong>notificaciones</strong></p>
                </a>

                <a class="adulto-accion-card" href="#preguntas-adulto">
                    <div class="adulto-accion-blanco">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#115e2e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                        </svg>
                    </div>
                    <p>Ver<br /><strong>conversaciones</strong></p>
                </a>
            </div>
        </section>

        <section class="joven-seccion">
            <div class="adulto-soporte-caja">
                <h3>¿Tenés dudas?</h3>
                <a class="joven-btn-ayuda" href="#preguntas-adulto">FYQ</a>
            </div>
        </section>

        <section class="joven-seccion">
            <h2>Sabías que:</h2>

            <div class="adulto-sabias-lista">
                <article class="adulto-sabias-card">
                    <div class="adulto-sabias-texto">
                        <h3>¡Nuestro cuerpo está compuesto por un 70% de <span class="texto-verde-destacado">agua</span>!</h3>
                        <p>
                            Tomá <span class="texto-verde-destacado">agua</span> varias veces al día, aunque no tengas sed. Tené siempre una botella o un vaso cerca para acordarte de <span class="texto-verde-destacado">hidratarte</span>.
                        </p>
                    </div>
                    <div class="adulto-sabias-ilustracion">
                        <svg xmlns="http://www.w3.org/2000/svg" width="110" height="110" viewBox="0 0 24 24" fill="none" stroke="#115e2e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" fill="#84cc54" stroke="#115e2e"></path>
                        </svg>
                    </div>
                </article>

                <article class="adulto-sabias-card">
                    <div class="adulto-sabias-texto">
                        <h3>¡Dormir bien es cuidar tu <span class="texto-verde-destacado">salud</span>!</h3>
                        <p>
                            Intentá acostarte y levantarte todos los días a horarios parecidos. <span class="texto-verde-destacado">Dormir</span> bien te ayuda a tener más <span class="texto-verde-destacado">energía</span> y a sentirte mejor durante el día.
                        </p>
                    </div>
                    <div class="adulto-sabias-ilustracion">
                        <svg xmlns="http://www.w3.org/2000/svg" width="110" height="110" viewBox="0 0 24 24" fill="none" stroke="#115e2e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="#84cc54" stroke="#115e2e"></path>
                        </svg>
                    </div>
                </article>
            </div>
        </section>

        <section class="joven-seccion" id="preguntas-adulto">
            <h2>Preguntas frecuentes</h2>

            <div class="adulto-faq-caja">
                <details class="adulto-faq-item">
                    <summary>
                        <span>¿Cómo pido una ayuda?</span>
                        <span class="adulto-faq-flecha">↓</span>
                    </summary>
                    <p>Hacé clic en el botón "Solicitá una Ayuda", completá el formulario con lo que necesitás, el lugar y el horario, y publicalo.</p>
                </details>

                <details class="adulto-faq-item">
                    <summary>
                        <span>¿Qué puedo hacer con Te Ayudo?</span>
                        <span class="adulto-faq-flecha">↓</span>
                    </summary>
                    <p>Podés solicitar asistencia para tareas cotidianas, compras, tecnología, jardinería o acompañamiento con jóvenes de tu comunidad.</p>
                </details>

                <details class="adulto-faq-item">
                    <summary>
                        <span>¿Es seguro pedir ayuda a jóvenes?</span>
                        <span class="adulto-faq-flecha">↓</span>
                    </summary>
                    <p>Sí, todos los jóvenes están registrados con sus datos personales y de contacto verificados dentro de nuestra comunidad.</p>
                </details>

                <details class="adulto-faq-item">
                    <summary>
                        <span>¿Cuánta plata cuesta pedir una Ayuda?</span>
                        <span class="adulto-faq-flecha">↓</span>
                    </summary>
                    <p>Se acuerda un monto accesible según la tarea solicitada para retribuir el tiempo y la ayuda del joven.</p>
                </details>
            </div>
        </section>
    </main>

    <footer>
        <div class="footer-content page">
            <a class="logo" href='@Url.Action("Index", "Home")'>
                <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
            </a>

            <div>
                <h3>Te Ayudo</h3>
                <a href='@Url.Action("Index", "Home")#nosotros'>Nuestra historia</a>
                <a href='@Url.Action("Index", "Home")#valores'>Nuestros valores</a>
            </div>

            <div>
                <h3>Ayudas</h3>
                <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
                <a href='@Url.Action("Index", "Home")#como-funciona'>Cómo funciona</a>
            </div>

            <div>
                <h3>Comunidad</h3>
                <a href='@Url.Action("Explorar", "Home")'>Mapa y comunidad</a>
            </div>

            <div>
                <h3>Mi cuenta</h3>
                <a href='@Url.Action("Perfil", "Home")'>Ver mi perfil</a>
                <a href='@Url.Action("CerrarSesion", "Home")'>Cerrar sesión</a>
            </div>
        </div>

        <p class="copyright">
            © <span id="year">2026</span> Te Ayudo.
            Todos los derechos reservados.
        </p>
    </footer>
</div>
