@{
    ViewData["Title"] = "Postulantes";
    Tareas? tarea = ViewBag.Tarea as Tareas;
    List<Usuarios>? postulantes = ViewBag.Postulantes as List<Usuarios>;
    int idTarea = tarea?.IdTarea ?? 0;
    string tituloTarea = !string.IsNullOrEmpty(tarea?.Titulo) ? tarea.Titulo : "esta ayuda";
}

<div class="joven-page">
    <header class="header header--joven">
        <a class="logo" href='@Url.Action("PrincipalAdulto", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <button class="menu-toggle"
                aria-expanded="false"
                aria-controls="navigation"
                aria-label="Abrir menú">
            ☰
        </button>

        <nav id="navigation" aria-label="Navegación principal">
            <a class="nav-button nav-button--joven" href='@Url.Action("Explorar", "Home")'>
                Explorá
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("PrincipalAdulto", "Home")#preguntas-adulto'>
                Preguntas frecuentes
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("SolicitarTarea", "Home")'>
                Solicitá ayudas
            </a>

            <a class="nav-perfil-avatar" href='@Url.Action("Perfil", "Home")' title="Perfil" aria-label="Perfil">
                @{
                    string rutaFotoNav = ((ViewBag.FotoPerfilSesion as string) ?? (ViewBag.Adulto?.FotoPerfil as string) ?? "").Trim();
                    bool tieneFotoPropia = !string.IsNullOrWhiteSpace(rutaFotoNav) && !rutaFotoNav.EndsWith("user.svg", StringComparison.OrdinalIgnoreCase);
                    string srcFotoNav = tieneFotoPropia
                        ? (rutaFotoNav.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                            ? rutaFotoNav
                            : Url.Content("~/" + rutaFotoNav.TrimStart('~', '/')))
                        : Url.Content("~/img/user.svg");
                }
                @if (tieneFotoPropia)
                {
                    <img src="@srcFotoNav" alt="Perfil" class="nav-perfil-foto" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                }
                <svg class="nav-perfil-svg" style="@(tieneFotoPropia ? "display:none;" : "")" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="14.5" r="7" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                    <path d="M7 38 C7 27.5 13 23.5 20 23.5 C27 23.5 33 27.5 33 38 Z" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                </svg>
            </a>
        </nav>
    </header>

    <main class="joven-main">
        <section class="postulados-contenedor" id="contenedorPostulantes" data-id-tarea="@idTarea">
            <h1 class="postulados-titulo">Postulantes para @tituloTarea</h1>

            @if (postulantes != null && postulantes.Count > 0)
            {
                <div class="postulados-grid">
                    @foreach (Usuarios joven in postulantes)
                    {
                        string srcFoto = string.IsNullOrEmpty(joven.FotoPerfil)
                            ? Url.Content("~/img/user.svg")
                            : Url.Content("~" + joven.FotoPerfil);
                        string nombreJoven = ((joven.Nombre ?? "") + " " + (joven.Apellido ?? "")).Trim();
                        if (string.IsNullOrEmpty(nombreJoven))
                        {
                            nombreJoven = joven.Email;
                        }

                        <article class="postulado-card" id="card-postulante-@joven.IdUsuario">
                            <img src="@srcFoto" alt="@nombreJoven" class="postulado-avatar" />

                            <div class="postulado-info">
                                <h3>@nombreJoven</h3>
                                <div class="postulado-botones">
                                    <button type="button" class="btn-ayuda-verde" onclick="aceptarPostulanteDirecto(@joven.IdUsuario, '@nombreJoven')">
                                        Aceptar
                                    </button>
                                    <button type="button" class="btn-ayuda-verde" onclick="abrirModalPostulante(@joven.IdUsuario)">
                                        Ver más
                                    </button>
                                    <button type="button" class="btn-ayuda-amarillo" onclick="rechazarPostulanteConUndo(@joven.IdUsuario)">
                                        Rechazar
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="joven-actividades-caja" style="max-width: 560px; margin: 0 auto;">
                    <div class="joven-actividad-fila" style="justify-content: center;">
                        <p>Todavía no hay postulantes para esta ayuda.</p>
                    </div>
                </div>
            }

            <div style="margin-top: 30px; text-align: center;">
                <a class="btn-ayuda-verde" href='@Url.Action("MisAyudas", "Home")'>Volver a mis ayudas</a>
            </div>
        </section>
    </main>

    <!-- MODAL DEL POSTULANTE (SE COMPLETA CON FETCH) -->
    <div id="modalPostulante" class="modal-postulante-fondo" style="display: none;">
        <div class="modal-postulante-card">
            <div class="modal-postulante-top">
                <button type="button" class="modal-postulante-cerrar" onclick="cerrarModalPostulante()" aria-label="Cerrar">×</button>
            </div>

            <div class="modal-postulante-body">
                <img id="modalPostulanteFoto" src="~/img/user.svg" alt="Postulante" class="modal-postulante-foto" />

                <div class="modal-postulante-info">
                    <h2 id="modalPostulanteNombre" class="modal-postulante-nombre"></h2>

                    <div class="modal-postulante-stats">
                        <div class="modal-stat">
                            <div class="modal-stat-icono">
                                <span id="modalPostulanteAyudas" class="modal-stat-badge">0</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="5" width="16" height="16" rx="2"></rect>
                                    <path d="M7 13l3 3 9-10"></path>
                                </svg>
                            </div>
                            <p>Ayudas realizadas</p>
                        </div>

                        <div class="modal-stat">
                            <div id="modalPostulanteEstrellas" class="modal-estrellas">☆☆☆☆☆</div>
                            <p>Valoración general</p>
                        </div>

                        <div class="modal-stat">
                            <div class="modal-stat-icono">
                                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            </div>
                            <p id="modalPostulantePuntual">Puntual</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-postulante-botones">
                <button type="button" class="btn-ayuda-verde" onclick="aceptarPostulanteFetch()">Aceptar</button>
                <button type="button" class="btn-ayuda-rojo" onclick="rechazarDesdeModal()">Rechazar</button>
            </div>
        </div>
    </div>

    <div id="snackbarPostulante" class="snackbar-rechazo" style="display: none;">
        <span>Postulante rechazado</span>
        <button type="button" class="snackbar-btn-deshacer" onclick="deshacerRechazoPostulante()">Deshacer</button>
    </div>

    <footer>
        <div class="footer-content page">
            <a class="logo" href='@Url.Action("Index", "Home")'>
                <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
            </a>

            <div>
                <h3>Te Ayudo</h3>
                <a href='@Url.Action("Index", "Home")#nosotros'>Nuestra historia</a>
                <a href='@Url.Action("Index", "Home")#valores'>Nuestros valores</a>
            </div>

            <div>
                <h3>Ayudas</h3>
                <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
                <a href='@Url.Action("MisAyudas", "Home")'>Ayudas pedidas</a>
            </div>

            <div>
                <h3>Comunidad</h3>
                <a href='@Url.Action("Explorar", "Home")'>Mapa y comunidad</a>
            </div>

            <div>
                <h3>Mi cuenta</h3>
                <a href='@Url.Action("Perfil", "Home")'>Ver mi perfil</a>
                <a href='@Url.Action("CerrarSesion", "Home")'>Cerrar sesión</a>
            </div>
        </div>

        <p class="copyright">
            © <span id="year">2026</span> Te Ayudo.
            Todos los derechos reservados.
        </p>
    </footer>
</div>
