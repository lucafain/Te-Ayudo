@{
    ViewData["Title"] = "Registrarse";
}

<main class="auth-page">
    <section class="auth-card auth-card--registro-adulto">
        <h1 class="auth-title">Registrarse</h1>
        <div class="auth-divider"></div>

        <p class="auth-note">
            Los datos opcionales le permitirán utilizar la aplicación con normalidad, por lo que recomendamos completar todo desde un principio. Igualmente, le daremos la posibilidad de completar y modificar los datos si que desee una vez que se registró.
        </p>

        <p class="auth-note">
            <span class="required-star">*</span> Los datos que tienen un asterísco en rojo a su derecha son obligatorios.
        </p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="auth-alert">@ViewBag.ErrorMessage</div>
        }

        <div id="mensajeErrorJs" class="auth-alert" style="display: none;"></div>

        <form action='@Url.Action("GuardarRegistroMayor", "Home")' method="post" enctype="multipart/form-data" id="formRegistro" class="form-centered-column">
            <div class="field">
                <label for="Email">Correo electrónico <span class="required-star">*</span></label>
                <input type="email" id="Email" name="Email" autocomplete="email" />
            </div>

            <div class="field">
                <label for="Nombre">Nombre de usuario <span class="required-star">*</span></label>
                <input type="text" id="Nombre" name="Nombre" autocomplete="username" />
            </div>

            <div class="field">
                <label for="Contrasena">Contraseña <span class="required-star">*</span></label>
                <div class="input-with-icons">
                    <input type="password" id="Contrasena" name="Contrasena" autocomplete="new-password" />
                    <button type="button" class="password-toggle-btn" id="btnTogglePassword" aria-label="Mostrar u ocultar contraseña">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="field">
                <label for="Telefono">Número telefónico</label>
                <input type="text" id="Telefono" name="Telefono" autocomplete="tel" />
            </div>

            <div class="field upload-field">
                <label for="FotoPerfil">Cargar foto de perfil</label>
                <label class="upload-button" for="FotoPerfil" data-file-label="FotoPerfil">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="upload-icon">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                </label>
                <input type="file" id="FotoPerfil" name="FotoPerfil" accept="image/*" />
                <span class="upload-filename" data-file-name="FotoPerfil">Ningún archivo seleccionado</span>
            </div>

            <div class="auth-actions">
                <button class="auth-button" type="submit">Registrarse</button>
            </div>

            <div class="auth-links">
                Ya tenés una cuenta? <a href='@Url.Action("Ingresar", "Home")'>Iniciar sesión</a>
            </div>
        </form>
    </section>
</main>
