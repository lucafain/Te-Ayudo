@{
    ViewData["Title"] = "Ayudas Para Realizar";
    Usuarios? joven = ViewBag.Joven as Usuarios;
    List<Tareas>? tareasPendientes = ViewBag.TareasPendientes as List<Tareas>;
    Dictionary<int, int>? distanciasTareas = ViewBag.DistanciasTareas as Dictionary<int, int>;
    Dictionary<int, string>? estadosPostulacion = ViewBag.EstadosPostulacion as Dictionary<int, string>;
    string nombreJoven = joven != null ? $"{joven.Nombre} {joven.Apellido}" : "Joven Voluntario";
    string srcFotoNav = (joven != null && !string.IsNullOrEmpty(joven.FotoPerfil))
        ? (joven.FotoPerfil.StartsWith("/") ? joven.FotoPerfil : "/img/" + joven.FotoPerfil)
        : "/img/Logo.png";
}

<!-- Navbar Principal Joven -->
<header id="header-bar">
    <div id="branding">
        <a href='@Url.Action("PrincipalJoven", "Home")'>
            <img src="~/img/Logo.png" alt="Logo Te Ayudo" />
        </a>
        <div>
            <h1>Te Ayudo</h1>
        </div>
    </div>

    <nav id="navigation">
        <a href='@Url.Action("PrincipalJoven", "Home")' class="nav-button">Explorá</a>
        <a href='@Url.Action("Conversaciones", "Home")' class="nav-button">Conversaciones</a>
        <a href='@Url.Action("AyudasParaRealizar", "Home")' class="nav-button nav-button-highlight">Realizá Ayudas</a>
        <button type="button" class="nav-bell-btn" title="Notificaciones">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
        </button>
        <a href='@Url.Action("Perfil", "Home")' class="nav-perfil-avatar" title="Mi Perfil">
            <img src="@srcFotoNav" alt="Foto de @nombreJoven" />
        </a>
    </nav>
</header>

<section class="ayudas-container">
    <!-- ==================== VISTA 1: LISTADO DE TAREAS ==================== -->
    <div id="vistaListaAyudas">
        <div class="ayudas-header">
            <h2>Ayudas disponibles para vos</h2>
            <p>Postulate a las tareas solicitadas por los adultos mayores o gestioná tus postulaciones.</p>
        </div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert-success-box" id="bannerMensajeExito">
                <p>@ViewBag.SuccessMessage</p>
            </div>
        }

        <div id="contenedorTarjetasAyudas">
            @if (tareasPendientes == null || tareasPendientes.Count == 0)
            {
                <div class="empty-tasks-box">
                    <p>Por el momento no hay tareas pendientes disponibles.</p>
                    <a href='@Url.Action("PrincipalJoven", "Home")' class="btn-volver-panel">Volver al Inicio</a>
                </div>
            }
            else
            {
                <div class="tasks-grid" id="gridTareasDisponibles">
                    @foreach (Tareas t in tareasPendientes)
                    {
                        int kmDistancia = (distanciasTareas != null && distanciasTareas.ContainsKey(t.IdTarea))
                            ? distanciasTareas[t.IdTarea]
                            : 2;
                        string estadoPost = (estadosPostulacion != null && estadosPostulacion.ContainsKey(t.IdTarea))
                            ? estadosPostulacion[t.IdTarea]
                            : "";
                        string textoUbicacion = !string.IsNullOrWhiteSpace(t.Direccion)
                            ? t.Direccion
                            : (!string.IsNullOrWhiteSpace(t.Barrio) ? t.Barrio : "Ubicación cercana");

                        if (estadoPost == "Aceptada")
                        {
                            <div class="task-card-joven task-card-aceptada" id="card-tarea-@t.IdTarea">
                                <div class="task-card-joven-top task-card-top-aceptada">
                                    <span class="task-card-joven-price task-price-white">$@t.Monto</span>
                                    <span class="task-card-status-dot"></span>
                                </div>
                                <div class="task-card-joven-body">
                                    <h3 class="task-card-joven-title">@t.Titulo</h3>
                                    <p class="task-card-status-subtitle">La tarea fue Aceptada</p>
                                    <div class="task-card-joven-actions">
                                        <button type="button" class="btn-joven-ver-mas btn-aceptada-ver-mas" onclick="verDetalleTareaAceptada(@t.IdTarea)">Ver más</button>
                                    </div>
                                    <div class="task-card-joven-footer">
                                        <span class="task-card-joven-pin" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="22" height="22" fill="#e52521">
                                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/>
                                            </svg>
                                        </span>
                                        <span class="task-card-joven-distance">@textoUbicacion (A @(kmDistancia)km de ti)</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (estadoPost == "Rechazada")
                        {
                            <div class="task-card-joven task-card-rechazada" id="card-tarea-@t.IdTarea">
                                <div class="task-card-joven-top task-card-top-rechazada">
                                    <span class="task-card-joven-price task-price-white">$@t.Monto</span>
                                </div>
                                <div class="task-card-joven-body">
                                    <h3 class="task-card-joven-title">@t.Titulo</h3>
                                    <p class="task-card-status-subtitle">No fuiste seleccionado para la tarea</p>
                                    <div class="task-card-joven-actions">
                                        <button type="button" class="btn-joven-eliminar-rechazada" onclick="eliminarTareaRechazadaFetch(@t.IdTarea)">Eliminar</button>
                                    </div>
                                    <div class="task-card-joven-footer">
                                        <span class="task-card-joven-pin" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="22" height="22" fill="#e52521">
                                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/>
                                            </svg>
                                        </span>
                                        <span class="task-card-joven-distance">@textoUbicacion (A @(kmDistancia)km de ti)</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="task-card-joven" id="card-tarea-@t.IdTarea">
                                <div class="task-card-joven-top">
                                    <span class="task-card-joven-price">$@t.Monto</span>
                                </div>
                                <div class="task-card-joven-body">
                                    <h3 class="task-card-joven-title">@t.Titulo</h3>
                                    <div class="task-card-joven-actions">
                                        <button type="button" class="btn-joven-ver-mas" onclick="verDetalleTareaFetch(@t.IdTarea)">Ver más</button>
                                        <button type="button" class="btn-joven-rechazar" onclick="rechazarTareaFetch(@t.IdTarea)">Rechazar</button>
                                    </div>
                                    <div class="task-card-joven-footer">
                                        <span class="task-card-joven-pin" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="22" height="22" fill="#e52521">
                                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/>
                                            </svg>
                                        </span>
                                        <span class="task-card-joven-distance">@textoUbicacion (A @(kmDistancia)km de ti)</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>

    <!-- ==================== VISTA 2: DETALLE DE LA TAREA (SIN RECARGAR) ==================== -->
    <div id="vistaDetalleAyuda" class="detalle-tarea-wrapper" style="display: none;">
        <div class="detalle-card-wireframe">
            <div class="detalle-top-row">
                <a href="javascript:void(0)" onclick="volverAListaAyudas()" class="detalle-back-arrow" title="Volver al listado">&#8592;</a>
                <h2 class="detalle-main-title" id="detTitulo">Detalle de Tarea</h2>
            </div>

            <div class="detalle-info-list">
                <p><strong>Descripción:</strong> <span id="detDescripcion"></span></p>
                <p><strong>Presupuesto:</strong> $<span id="detMonto"></span></p>
                <p><strong>Duración máxima:</strong> <span id="detDuracion"></span></p>
                <p><strong>Tiempo disponible:</strong> <span id="detHorario"></span></p>
                <p><strong>Adulto mayor solicitante:</strong> <span id="detSolicitante"></span></p>
                <p><strong>Domicilio:</strong> <span id="detDomicilio"></span></p>
                <p><strong>Acompañamiento:</strong> <span id="detAcompaniamiento"></span></p>
            </div>

            <!-- Acciones de la vista de detalle -->
            <div class="detalle-bottom-actions">
                <button type="button" id="btnPostularseFetch" class="btn-detalle-aceptar" onclick="postularseTareaFetch()">Aceptar</button>
                <button type="button" id="btnRechazarDetalleFetch" class="btn-detalle-rechazar" onclick="rechazarDesdeDetalleFetch()">Rechazar</button>
                <button type="button" id="btnVerPostuladosFetch" class="btn-detalle-postulados" onclick="verPostuladosTareaFetch()">Ver postulados</button>
            </div>
        </div>
    </div>

    <!-- ==================== VISTA 2B: DETALLE DE TAREA ACEPTADA (WIREFRAME EXACTO) ==================== -->
    <div id="vistaDetalleAceptada" class="detalle-aceptada-wrapper" style="display: none;">
        <div class="detalle-aceptada-card">
            <a href="javascript:void(0)" onclick="volverAListaAyudas()" class="detalle-aceptada-back" title="Volver">&#8592;</a>
            <h2 class="detalle-aceptada-title" id="detAceptadaTitulo">Detalle de Tarea</h2>

            <div class="detalle-aceptada-info">
                <p><strong>Descripción:</strong> <span id="detAceptadaDescripcion"></span></p>
                <p><strong>Tiempo disponible:</strong> <span id="detAceptadaHorario"></span></p>
                <p><strong>Duración máxima:</strong> <span id="detAceptadaDuracion"></span></p>
                <p><strong>Presupuesto:</strong> $<span id="detAceptadaMonto"></span></p>
                <p><strong>Solicitante:</strong> <span id="detAceptadaSolicitante"></span></p>
                <p><strong>Domicilio:</strong> <span id="detAceptadaDomicilio"></span></p>
            </div>

            <div class="detalle-aceptada-actions">
                <button type="button" class="btn-finalizar-tarea-aceptada" onclick="finalizarTareaAceptadaFetch()">Finalizar Tarea</button>
            </div>
        </div>
    </div>

    <!-- ==================== VISTA 3: POSTULADOS DE LA TAREA (SOLO LECTURA) ==================== -->
    <div id="vistaPostuladosAyuda" class="postulados-wrapper" style="display: none;">
        <div class="postulados-header-bar">
            <a href="javascript:void(0)" onclick="volverADetalleDesdePostulados()" class="detalle-back-arrow" title="Volver al detalle">&#8592;</a>
            <div class="postulados-title-pill">
                <h2>Postulados: <span id="postuladosNombreTarea"></span></h2>
            </div>
        </div>

        <div id="listaPostuladosContainer" class="postulados-cards-container">
            <!-- Se llena dinámicamente con fetch -->
        </div>
    </div>
</section>

<!-- Snackbar inferior al rechazar tarea -->
<div id="snackbarRechazo" class="snackbar-rechazo" style="display: none;">
    <span>Se rechazó la ayuda de manera exitosa.</span>
    <button type="button" class="snackbar-close-btn" onclick="cerrarSnackbarRechazo()">&#10005;</button>
</div>
