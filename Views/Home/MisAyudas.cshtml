@{
    ViewData["Title"] = "Ayudas pedidas";
    List<Tareas>? misTareas = ViewBag.MisTareas as List<Tareas>;
    Dictionary<int, int>? cantidadPostulantes = ViewBag.CantidadPostulantes as Dictionary<int, int>;
}

<div class="joven-page">
    <header class="header header--joven">
        <a class="logo" href='@Url.Action("PrincipalAdulto", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <button class="menu-toggle"
                aria-expanded="false"
                aria-controls="navigation"
                aria-label="Abrir menú">
            ☰
        </button>

        <nav id="navigation" aria-label="Navegación principal">
            <a class="nav-button nav-button--joven" href='@Url.Action("Explorar", "Home")'>
                Explorá
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("PrincipalAdulto", "Home")#preguntas-adulto'>
                Preguntas frecuentes
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("SolicitarTarea", "Home")'>
                Solicitá ayudas
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("Perfil", "Home")'>
                Perfil
            </a>
        </nav>
    </header>

    <main class="joven-main">
        <section class="joven-seccion">
            <h1 class="ayudas-titulo-principal">Ayudas pedidas</h1>

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="auth-alert" style="max-width: 520px; margin: 0 auto 24px; background: #ffffff; color: #0d6e2b;">
                    @ViewBag.SuccessMessage
                </div>
            }

            @if (misTareas != null && misTareas.Count > 0)
            {
                <div class="ayudas-grid">
                    @foreach (Tareas tarea in misTareas)
                    {
                        int postulantes = 0;
                        if (cantidadPostulantes != null && cantidadPostulantes.ContainsKey(tarea.IdTarea))
                        {
                            postulantes = cantidadPostulantes[tarea.IdTarea];
                        }

                        <article class="ayuda-card">
                            <div class="ayuda-card-top"></div>

                            <div class="ayuda-card-body">
                                <h3>@tarea.Titulo</h3>
                                <p class="ayuda-card-postulantes">
                                    @postulantes @(postulantes == 1 ? "postulante" : "postulantes")
                                </p>

                                <div class="ayuda-card-botones">
                                    <a class="btn-ayuda-verde" href='@Url.Action("PostulantesTarea", "Home", new { idTarea = tarea.IdTarea })'>
                                        Ver más
                                    </a>

                                    @if (postulantes == 0)
                                    {
                                        <form action='@Url.Action("CancelarTarea", "Home")' method="post" style="display: inline;">
                                            <input type="hidden" name="idTarea" value="@tarea.IdTarea" />
                                            <button type="submit" class="btn-ayuda-rojo">Cancelar</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-ayuda-deshabilitado" disabled title="No se puede cancelar porque ya tiene postulantes">
                                            Cancelar
                                        </button>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="joven-actividades-caja" style="max-width: 560px; margin: 0 auto;">
                    <div class="joven-actividad-fila" style="justify-content: center;">
                        <p>Todavía no pediste ninguna ayuda.</p>
                    </div>
                </div>
            }

            <div style="margin-top: 36px;">
                <a class="btn-nueva-ayuda" href='@Url.Action("SolicitarTarea", "Home")'>
                    Pedí una nueva Ayuda
                </a>
            </div>
        </section>
    </main>

    <footer>
        <div class="footer-content page">
            <a class="logo" href='@Url.Action("Index", "Home")'>
                <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
            </a>

            <div>
                <h3>Te Ayudo</h3>
                <a href='@Url.Action("Index", "Home")#nosotros'>Nuestra historia</a>
                <a href='@Url.Action("Index", "Home")#valores'>Nuestros valores</a>
            </div>

            <div>
                <h3>Ayudas</h3>
                <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
                <a href='@Url.Action("MisAyudas", "Home")'>Ayudas pedidas</a>
            </div>

            <div>
                <h3>Comunidad</h3>
                <a href='@Url.Action("Explorar", "Home")'>Mapa y comunidad</a>
            </div>

            <div>
                <h3>Mi cuenta</h3>
                <a href='@Url.Action("Perfil", "Home")'>Ver mi perfil</a>
                <a href='@Url.Action("CerrarSesion", "Home")'>Cerrar sesión</a>
            </div>
        </div>

        <p class="copyright">
            © <span id="year">2026</span> Te Ayudo.
            Todos los derechos reservados.
        </p>
    </footer>
</div>
