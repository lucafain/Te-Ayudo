@{
	ViewData["Title"] = "Página principal (Adultos)";
}

<header>
	<a asp-controller="Home" asp-action="Index" aria-label="Ir al inicio">
		<img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
	</a>

	<nav aria-label="Navegación principal adultos">
		<a href="#explorar">Explorá</a>
		<a href="#preguntas-frecuentes">Preguntas frecuentes</a>
		<a asp-controller="Home" asp-action="Trabajar">Sumate como joven</a>
		<a asp-controller="Home" asp-action="RegistroMayor">Solicitá ayudas</a>
	</nav>
</header>

<main>
	<section id="explorar" aria-labelledby="hero-title">
		<img src="~/img/adultos-hero.jpg" alt="Joven ayudando a una persona mayor" />

		<div>
			<h1 id="hero-title">Bienvenido, Tomu</h1>
			<p>Recibí asistencia a un monto accesible.</p>
			<p>Ayudá a un joven a adquirir experiencia laboral.</p>

			<a asp-controller="Home" asp-action="RegistroMayor">Solicitá una ayuda</a>
		</div>
	</section>

	<section aria-labelledby="acciones-title">
		<h2 id="acciones-title">¿Qué necesitás hacer?</h2>

		<div>
			<article>
				<img src="~/img/icono-ayudas.png" alt="Ver ayudas" />
				<h3>Ver ayudas</h3>
			</article>

			<article>
				<img src="~/img/icono-notificaciones.png" alt="Ver notificaciones" />
				<h3>Ver notificaciones</h3>
			</article>

			<article>
				<img src="~/img/icono-conversaciones.png" alt="Ver conversaciones" />
				<h3>Ver conversaciones</h3>
			</article>
		</div>
	</section>

	<section aria-labelledby="soporte-title">
		<h2 id="soporte-title">¿Tenés dudas?</h2>
		<a href="#">Soporte</a>
	</section>

	<section aria-labelledby="sabias-que-title">
		<h2 id="sabias-que-title">Sabías que:</h2>

		<article>
			<div>
				<p>
					Tomá agua varias veces al día, aunque no tengas sed.
					Tené siempre una botella o un vaso cerca para acordarte de hidratarte.
				</p>
			</div>
			<img src="~/img/tip-hidratacion.png" alt="Consejo de hidratación" />
		</article>

		<article>
			<div>
				<p>
					Dormir bien ayuda a mejorar tu energía y tu bienestar diario.
					Intentá mantener una rutina de descanso.
				</p>
			</div>
			<img src="~/img/tip-descanso.png" alt="Consejo de descanso" />
		</article>
	</section>

	<section id="preguntas-frecuentes" aria-labelledby="faq-title">
		<h2 id="faq-title">Preguntas frecuentes</h2>

		<details>
			<summary>¿Cómo pido una ayuda?</summary>
			<p>Desde el botón “Solicitá ayudas” podés completar tu solicitud.</p>
		</details>

		<details>
			<summary>¿Qué puedo hacer con Te Ayudo?</summary>
			<p>Podés solicitar apoyo para tareas cotidianas y comunicarte con jóvenes registrados.</p>
		</details>

		<details>
			<summary>¿Es seguro pedir ayuda a jóvenes?</summary>
			<p>La plataforma promueve una comunidad de apoyo con perfiles registrados.</p>
		</details>

		<details>
			<summary>¿Cuánta plata cuesta pedir una ayuda?</summary>
			<p>El costo depende del tipo de ayuda y del acuerdo entre las partes.</p>
		</details>
	</section>
</main>

<footer>
	<a asp-controller="Home" asp-action="Index" aria-label="Ir al inicio">
		<img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
	</a>

	<section aria-label="Te Ayudo">
		<h3>Te Ayudo</h3>
		<a href="#">Desarrolladores</a>
		<a href="#">Nuestra historia</a>
	</section>

	<section aria-label="Categorías">
		<h3>Categorías</h3>
		<a href="#explorar">Explorá</a>
		<a href="#preguntas-frecuentes">Preguntas frecuentes</a>
	</section>

	<section aria-label="Sumate como joven">
		<h3>Sumate como joven</h3>
		<a asp-controller="Home" asp-action="Trabajar">Explorá</a>
		<a href="#preguntas-frecuentes">Preguntas frecuentes</a>
	</section>

	<section aria-label="Ayuda">
		<h3>Ayuda</h3>
		<a href="#">Términos y condiciones</a>
		<a href="#">Centro de ayuda</a>
	</section>

	<section aria-label="Redes sociales">
		<a href="#" aria-label="Instagram">Instagram</a>
		<a href="#" aria-label="X">X</a>
		<a href="#" aria-label="Facebook">Facebook</a>
		<a href="#" aria-label="TikTok">TikTok</a>
	</section>

	<p>© 2026 Te Ayudo. Todos los derechos reservados.</p>
</footer>
