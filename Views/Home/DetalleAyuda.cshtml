@{
    ViewData["Title"] = "Detalle de la ayuda";
    Tareas? tarea = ViewBag.Tarea as Tareas;
    Usuarios? solicitante = ViewBag.Solicitante as Usuarios;

    int idTarea = tarea?.IdTarea ?? 0;
    string nombreSolicitante = solicitante != null
        ? ((solicitante.Nombre ?? "") + " " + (solicitante.Apellido ?? "")).Trim()
        : "Adulto mayor";
    if (string.IsNullOrEmpty(nombreSolicitante))
    {
        nombreSolicitante = solicitante?.Email ?? "Adulto mayor";
    }

    string rutaFoto = solicitante?.FotoPerfil ?? "";
    string srcFoto = string.IsNullOrEmpty(rutaFoto)
        ? Url.Content("~/img/user.svg")
        : Url.Content("~" + rutaFoto);

    DateTime fechaMostrar = tarea != null
        ? (tarea.DiaFecha.Year > 1 ? tarea.DiaFecha : (tarea.DiaTarea.Year > 1 ? tarea.DiaTarea : tarea.FechaCreacion))
        : DateTime.Now;
    string horaMostrar = tarea != null ? tarea.HoraTarea.ToString(@"hh\:mm") : "15:00";

    string rutaFotoNav = ((ViewBag.FotoPerfilSesion as string) ?? (ViewBag.Joven?.FotoPerfil as string) ?? "").Trim();
    bool tieneFotoPropia = !string.IsNullOrWhiteSpace(rutaFotoNav) && !rutaFotoNav.EndsWith("user.svg", StringComparison.OrdinalIgnoreCase);
    string srcFotoNav = tieneFotoPropia
        ? (rutaFotoNav.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? rutaFotoNav
            : Url.Content("~/" + rutaFotoNav.TrimStart('~', '/')))
        : Url.Content("~/img/user.svg");
}

<div class="joven-page">
    <header class="header header--joven">
        <a class="logo" href='@Url.Action("PrincipalJoven", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <button class="menu-toggle"
                aria-expanded="false"
                aria-controls="navigation"
                aria-label="Abrir menú">
            ☰
        </button>

        <nav id="navigation" aria-label="Navegación principal">
            <a class="nav-button nav-button--joven" href='@Url.Action("Explorar", "Home")'>
                Explorá
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("PrincipalJoven", "Home")#ultimas-actividades'>
                Conversaciones
            </a>

            <a class="nav-button nav-button--joven nav-button--joven-claro" href='@Url.Action("AyudasParaRealizar", "Home")'>
                Realizá Ayudas
            </a>

            <a class="nav-notif-btn" href='@Url.Action("PrincipalJoven", "Home")#ultimas-actividades' title="Notificaciones" aria-label="Notificaciones">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
            </a>

            <a class="nav-perfil-avatar" href='@Url.Action("Perfil", "Home")' title="Perfil" aria-label="Perfil">
                @if (tieneFotoPropia)
                {
                    <img src="@srcFotoNav" alt="Perfil" class="nav-perfil-foto" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                }
                <svg class="nav-perfil-svg" style="@(tieneFotoPropia ? "display:none;" : "")" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="14.5" r="7" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                    <path d="M7 38 C7 27.5 13 23.5 20 23.5 C27 23.5 33 27.5 33 38 Z" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                </svg>
            </a>
        </nav>
    </header>

    <main class="joven-main">
        <section class="detalle-ayuda-contenedor" id="detalleAyudaFetchContainer" data-id-tarea="@idTarea">
            <div class="detalle-ayuda-card">
                <img id="detalleTareaFoto" src="@srcFoto" alt="@nombreSolicitante" class="detalle-ayuda-foto" />

                <div class="detalle-ayuda-info">
                    <h1 id="detalleTareaSolicitante" class="detalle-ayuda-nombre">@nombreSolicitante</h1>

                    <p id="detalleTareaTitulo" class="detalle-ayuda-linea">@(tarea?.Titulo)</p>
                    <p id="detalleTareaLugar" class="detalle-ayuda-linea">@(tarea?.Lugar)</p>
                    <p id="detalleTareaFechaHora" class="detalle-ayuda-linea">@fechaMostrar.ToString("dd/MM/yyyy") @horaMostrar hs</p>
                    <p id="detalleTareaDescripcion" class="detalle-ayuda-descripcion">
                        @(tarea?.Descripcion)
                        @if (!string.IsNullOrEmpty(tarea?.Aclaracion))
                        {
                            <span> · @tarea.Aclaracion</span>
                        }
                    </p>

                    <div class="detalle-ayuda-botones">
                        <a class="btn-detalle-cancelar" href='@Url.Action("AyudasParaRealizar", "Home")'>
                            Cancelar
                        </a>

                        <form action='@Url.Action("Postularse", "Home")' method="post" style="display: inline;">
                            <input type="hidden" name="idTarea" value="@idTarea" />
                            <button type="submit" class="btn-detalle-postular">
                                Postularme ahora
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="footer-content page">
            <a class="logo" href='@Url.Action("Index", "Home")'>
                <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
            </a>

            <div>
                <h3>Te Ayudo</h3>
                <a href='@Url.Action("Index", "Home")#nosotros'>Nuestra historia</a>
                <a href='@Url.Action("Index", "Home")#valores'>Nuestros valores</a>
            </div>

            <div>
                <h3>Explorá</h3>
                <a href='@Url.Action("Explorar", "Home")'>Mapa y comunidad</a>
                <a href='@Url.Action("Index", "Home")#como-funciona'>Cómo funciona</a>
                <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
            </div>

            <div>
                <h3>Trabajá con nosotros</h3>
                <a href='@Url.Action("Index", "Home")#trabaja'>Conocé la propuesta</a>
                <a href='@Url.Action("RegistroJoven", "Home")'>
                    Sumate
                </a>
            </div>

            <div>
                <h3>Ayuda</h3>
                <a href='@Url.Action("Index", "Home")#preguntas'>Preguntas frecuentes</a>
                <a href='@Url.Action("Perfil", "Home")'>
                    Mi cuenta
                </a>
            </div>
        </div>

        <p class="copyright">
            © <span id="year">2026</span> Te Ayudo.
            Todos los derechos reservados.
        </p>
    </footer>
</div>
