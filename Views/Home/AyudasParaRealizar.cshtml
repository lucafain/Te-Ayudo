@{
    ViewData["Title"] = "Ayudas para realizar";
    List<Tareas>? tareasPendientes = ViewBag.TareasPendientes as List<Tareas>;
    Usuarios? jovenActual = ViewBag.Joven as Usuarios;

    // Coordenadas aproximadas (lat, lon) de barrios de CABA para estimar los km de distancia
    Dictionary<string, (double lat, double lon)> coordsBarrios = new Dictionary<string, (double lat, double lon)>
    {
        { "almagro", (-34.6090, -58.4210) },
        { "yatay", (-34.6095, -58.4265) },
        { "yatai", (-34.6095, -58.4265) },
        { "villa crespo", (-34.5980, -58.4420) },
        { "araoz", (-34.5940, -58.4280) },
        { "caballito", (-34.6180, -58.4420) },
        { "avellaneda", (-34.6240, -58.4580) },
        { "boyaca", (-34.6230, -58.4620) },
        { "flores", (-34.6280, -58.4630) },
        { "floresta", (-34.6310, -58.4830) },
        { "palermo", (-34.5830, -58.4250) },
        { "cordoba", (-34.5990, -58.3960) },
        { "corrientes", (-34.6040, -58.4110) },
        { "balvanera", (-34.6090, -58.4010) },
        { "once", (-34.6080, -58.4060) },
        { "abasto", (-34.6030, -58.4110) },
        { "recoleta", (-34.5890, -58.3930) },
        { "belgrano", (-34.5620, -58.4560) },
        { "nuñez", (-34.5450, -58.4650) },
        { "nunez", (-34.5450, -58.4650) },
        { "colegiales", (-34.5750, -58.4480) },
        { "chacarita", (-34.5880, -58.4540) },
        { "paternal", (-34.5990, -58.4680) },
        { "boedo", (-34.6260, -58.4170) },
        { "san cristobal", (-34.6230, -58.4020) },
        { "san telmo", (-34.6210, -58.3730) },
        { "monserrat", (-34.6120, -58.3820) },
        { "microcentro", (-34.6037, -58.3816) },
        { "villa urquiza", (-34.5730, -58.4870) },
        { "villa devoto", (-34.6010, -58.5120) },
        { "villa del parque", (-34.6040, -58.4910) },
        { "saavedra", (-34.5540, -58.4880) },
        { "coghlan", (-34.5600, -58.4740) },
        { "parque patricios", (-34.6370, -58.4000) },
        { "barracas", (-34.6440, -58.3770) },
        { "la boca", (-34.6350, -58.3640) },
        { "puerto madero", (-34.6110, -58.3620) },
        { "retiro", (-34.5920, -58.3770) },
        { "constitucion", (-34.6270, -58.3840) },
        { "liniers", (-34.6420, -58.5230) },
        { "mataderos", (-34.6560, -58.5080) }
    };

    (double lat, double lon) ObtenerCoordsTexto(string texto, (double lat, double lon) porDefecto)
    {
        if (string.IsNullOrWhiteSpace(texto))
        {
            return porDefecto;
        }
        string limpio = texto.ToLower()
            .Replace("á", "a").Replace("é", "e").Replace("í", "i").Replace("ó", "o").Replace("ú", "u");
        foreach (KeyValuePair<string, (double lat, double lon)> par in coordsBarrios)
        {
            if (limpio.Contains(par.Key))
            {
                return par.Value;
            }
        }
        return porDefecto;
    }

    // Ubicación base del joven (por defecto Almagro / ORT Yatay si su calle/provincia no coincide con un barrio específico)
    string textoUbicacionJoven = ((jovenActual?.Calle ?? "") + " " + (jovenActual?.Provincia ?? "")).Trim();
    (double lat, double lon) coordsJoven = ObtenerCoordsTexto(textoUbicacionJoven, (-34.6095, -58.4265));

    int CalcularKmAprox(Tareas t)
    {
        string textoTarea = ((t.Barrio ?? "") + " " + (t.Lugar ?? "")).Trim();
        (double lat, double lon) coordsTarea = ObtenerCoordsTexto(textoTarea, (0, 0));

        if (coordsTarea.lat != 0)
        {
            double dLat = (coordsTarea.lat - coordsJoven.lat) * 111.0;
            double dLon = (coordsTarea.lon - coordsJoven.lon) * 91.0;
            double dist = System.Math.Sqrt(dLat * dLat + dLon * dLon) * 1.35; // factor de recorrido urbano
            int km = (int)System.Math.Round(dist);
            if (km < 1) km = 2;
            if (km > 15) km = 12;
            return km;
        }

        // Estimación alternativa basada en altura de dirección o ID de tarea
        int[] distanciasBase = new int[] { 2, 3, 5, 10, 2, 5, 3, 4, 6 };
        return distanciasBase[System.Math.Abs(t.IdTarea) % distanciasBase.Length];
    }
}

<div class="joven-page">
    <header class="header header--joven">
        <a class="logo" href='@Url.Action("PrincipalJoven", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <button class="menu-toggle"
                aria-expanded="false"
                aria-controls="navigation"
                aria-label="Abrir menú">
            ☰
        </button>

        <nav id="navigation" aria-label="Navegación principal">
            <a class="nav-button nav-button--joven" href='@Url.Action("Explorar", "Home")'>
                Explorá
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("Index", "Home")#preguntas'>
                Preguntas frecuentes
            </a>
            
            <a class="nav-button nav-button--joven" href='@Url.Action("Perfil", "Home")'>
                Perfil
            </a>
        </nav>
    </header>

    <main class="joven-main">
        <!-- VISTA 1: GRILLA DE AYUDAS PARA REALIZAR -->
        <section class="joven-seccion" id="vistaGrillaAyudas">
            <h1 class="ayudas-titulo-principal">Ayudas para realizar</h1>

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="auth-alert" style="max-width: 520px; margin: 0 auto 24px; background: #ffffff; color: #0d6e2b;">
                    @ViewBag.SuccessMessage
                </div>
            }

            @if (tareasPendientes != null && tareasPendientes.Count > 0)
            {
                <div class="ayudas-grid">
                    @foreach (Tareas tarea in tareasPendientes)
                    {
                        string montoMostrar = tarea.Monto > 0 ? tarea.Monto.ToString("0") : "5000";
                        string direccionMostrar = !string.IsNullOrWhiteSpace(tarea.Lugar)
                            ? tarea.Lugar
                            : (!string.IsNullOrWhiteSpace(tarea.Barrio) ? tarea.Barrio : "CABA");
                        int kmAprox = CalcularKmAprox(tarea);

                        <article class="ayuda-card" id="card-tarea-@tarea.IdTarea">
                            <div class="ayuda-card-top">
                                <span class="ayuda-card-monto">$@montoMostrar</span>
                            </div>

                            <div class="ayuda-card-body">
                                <h3>@tarea.Titulo</h3>

                                <div class="ayuda-card-botones">
                                    <button type="button" class="btn-ayuda-verde" onclick="abrirDetalleTareaFetch(@tarea.IdTarea)">
                                        Ver más
                                    </button>

                                    <button type="button" class="btn-ayuda-rojo" onclick="rechazarTareaConUndo(@tarea.IdTarea)">
                                        Rechazar
                                    </button>
                                </div>

                                <div class="ayuda-card-ubicacion">
                                    <span class="ayuda-card-direccion">@direccionMostrar</span>
                                    <span class="ayuda-card-distancia">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                            <circle cx="12" cy="10" r="3"></circle>
                                        </svg>
                                        A @(kmAprox)km de ti
                                    </span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="joven-actividades-caja" style="max-width: 560px; margin: 0 auto;">
                    <div class="joven-actividad-fila" style="justify-content: center;">
                        <p>No hay ayudas pendientes para realizar en este momento.</p>
                    </div>
                </div>
            }
        </section>

        <!-- VISTA 2: DETALLE DE LA AYUDA (CARGADA CON FETCH) -->
        <section class="detalle-ayuda-contenedor" id="vistaDetalleAyuda" style="display: none;">
            <div class="detalle-ayuda-card">
                <img id="detalleTareaFoto" src="~/img/user.svg" alt="Solicitante" class="detalle-ayuda-foto" />

                <div class="detalle-ayuda-info">
                    <h1 id="detalleTareaSolicitante" class="detalle-ayuda-nombre">Adulto mayor</h1>

                    <p id="detalleTareaTitulo" class="detalle-ayuda-linea"></p>
                    <p id="detalleTareaLugar" class="detalle-ayuda-linea"></p>
                    <p id="detalleTareaFechaHora" class="detalle-ayuda-linea"></p>
                    <p id="detalleTareaDescripcion" class="detalle-ayuda-descripcion"></p>

                    <div class="detalle-ayuda-botones">
                        <button type="button" class="btn-detalle-cancelar" onclick="volverAGrillaAyudas()">
                            Cancelar
                        </button>

                        <button type="button" class="btn-detalle-postular" onclick="postularmeConFetch()">
                            Postularme ahora
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- VISTA 3: POSTULADOS A LA AYUDA (CARGADA CON FETCH AL POSTULARSE) -->
        <section class="postulados-contenedor" id="vistaPostuladosAyuda" style="display: none;">
            <h1 id="tituloPostuladosFetch" class="postulados-titulo">¡Ya estás postulado!</h1>

            <div id="grillaPostuladosFetch" class="postulados-grid"></div>

            <div id="contenedorDetalleFetch" class="detalle-fetch-card" style="display: none;">
                <h3 id="detalleNombre"></h3>
                <p id="detalleEmail"></p>
                <p id="detalleTelefono"></p>
                <p id="detalleTipo"></p>
            </div>
        </section>
    </main>

    <div id="snackbarRechazo" class="snackbar-rechazo" style="display: none;">
        <span>Ayuda rechazada</span>
        <button type="button" class="snackbar-btn-deshacer" onclick="deshacerRechazoTarea()">Deshacer</button>
    </div>

    <footer>
        <div class="footer-content page">
            <a class="logo" href='@Url.Action("Index", "Home")'>
                <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
            </a>

            <div>
                <h3>Te Ayudo</h3>
                <a href='@Url.Action("Index", "Home")#nosotros'>Nuestra historia</a>
                <a href='@Url.Action("Index", "Home")#valores'>Nuestros valores</a>
            </div>

            <div>
                <h3>Explorá</h3>
                <a href='@Url.Action("Explorar", "Home")'>Mapa y comunidad</a>
                <a href='@Url.Action("Index", "Home")#como-funciona'>Cómo funciona</a>
                <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
            </div>

            <div>
                <h3>Trabajá con nosotros</h3>
                <a href='@Url.Action("Index", "Home")#trabaja'>Conocé la propuesta</a>
                <a href='@Url.Action("RegistroJoven", "Home")'>
                    Sumate
                </a>
            </div>

            <div>
                <h3>Ayuda</h3>
                <a href='@Url.Action("Index", "Home")#preguntas'>Preguntas frecuentes</a>
                <a href='@Url.Action("Perfil", "Home")'>
                    Mi cuenta
                </a>
            </div>
        </div>

        <p class="copyright">
            © <span id="year">2026</span> Te Ayudo.
            Todos los derechos reservados.
        </p>
    </footer>
</div>
