</header>

<main class="page" id="inicio-adulto">
    <section class="hero">
        <h1>¡Hola, @nombreAdulto!</h1>
        <p style="margin-top: 12px;">¿En qué podemos acompañarte hoy?</p>
        <div style="margin-top: 24px;">
            <a class="button" href='@Url.Action("SolicitarTarea", "Home")'>
                Solicitar una ayuda
            </a>
        </div>
    </section>

    <section class="how panel">
        <h2>Acciones rápidas</h2>

        <div class="steps">
            <article>
                <h3>Pedir ayuda</h3>
                <div class="icon-box">
                    <img src="~/img/pen.png" alt="" />
                </div>
                <p>Publicá la tarea o acompañamiento que necesitás.</p>
                <div style="margin-top: 12px;">
                    <a class="button" href='@Url.Action("SolicitarTarea", "Home")'>Solicitar</a>
                </div>
            </article>

            <article>
                <h3>Mi perfil</h3>
                <div class="icon-box">
                    <img src="~/img/user.svg" alt="" />
                </div>
                <p>Consultá tus datos personales y de ubicación.</p>
                <div style="margin-top: 12px;">
                    <a class="button" href='@Url.Action("Perfil", "Home")'>Ver perfil</a>
                </div>
            </article>

            <article>
                <h3>Comunidad</h3>
                <div class="icon-box">
                    <img src="~/img/circle-check.png" alt="" />
                </div>
                <p>Conocé a los jóvenes que forman parte de Te Ayudo.</p>
                <div style="margin-top: 12px;">
                    <a class="button" href="#jovenes-comunidad">Ver jóvenes</a>
                </div>
            </article>
        </div>
    </section>

    <section class="panel seccion-ultimos-ayudados" id="mis-tareas">
        <h2>Mis tareas solicitadas</h2>
        <div class="contenedor-lista-ayudados">
            @{
                List<Tareas>? misTareas = ViewBag.MisTareas as List<Tareas>;
            }
            @if (misTareas != null && misTareas.Count > 0)
            {
                foreach (Tareas tarea in misTareas)
                {
                    DateTime fechaMostrar = tarea.DiaFecha.Year > 1 ? tarea.DiaFecha : (tarea.DiaTarea.Year > 1 ? tarea.DiaTarea : tarea.FechaCreacion);
                    <div class="item-tarjeta-ayudado">
                        <div class="ayudado-info-usuario" style="text-align: left; display: block;">
                            <span class="nombre-usuario-ayudado">@tarea.Titulo</span>
                            <p style="font-size: 14px; margin-top: 4px;">@tarea.Descripcion</p>
                            <p style="font-size: 13px; color: #555; margin-top: 4px;">
                                Lugar: @tarea.Lugar · Fecha: @fechaMostrar.ToString("dd/MM/yyyy")
                                @if (!string.IsNullOrEmpty(tarea.Aclaracion))
                                {
                                    <span> · @tarea.Aclaracion</span>
                                }
                            </p>
                        </div>
                        <div class="ayudado-acciones">
                            <span class="posicion-ranking-numero">@(tarea.Estado ? "Activa" : "Finalizada")</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="item-tarjeta-ayudado">
                    <span class="nombre-usuario-ayudado">Aún no tenés tareas solicitadas.</span>
                </div>
            }
        </div>
    </section>

    <section class="values panel">
        <h2>Consejos para tu seguridad</h2>

        <div class="value-grid">
            <article>
                <h3>Coordiná por la app</h3>
                <div class="icon-box">
                    <img src="~/img/circle-check.png" alt="" />
                </div>
                <p>Acordá siempre el día, horario y detalles de la tarea antes del encuentro.</p>
            </article>

            <article>
                <h3>Perfiles verificados</h3>
                <div class="icon-box">
                    <img src="~/img/pen.png" alt="" />
                </div>
                <p>Todos los jóvenes registrados cuentan con sus datos en nuestra comunidad.</p>
            </article>

            <article>
                <h3>Acompañamiento</h3>
                <div class="icon-box">
                    <img src="~/img/alarm.png" alt="" />
                </div>
                <p>Puntualidad y trato respetuoso en cada ayuda solicitada.</p>
            </article>
        </div>
    </section>

    <section class="panel seccion-ultimos-ayudados" id="jovenes-comunidad">
        <h2>Jóvenes disponibles en tu comunidad</h2>
        <div class="contenedor-lista-ayudados">
            @{
                List<Usuarios>? listaJovenes = ViewBag.Jovenes as List<Usuarios>;
            }
            @if (listaJovenes != null && listaJovenes.Count > 0)
            {
                int posicion = 1;
                foreach (Usuarios joven in listaJovenes)
                {
                    string rutaFotoJoven = joven.FotoPerfil ?? "";
                    string srcJoven = string.IsNullOrEmpty(rutaFotoJoven)
                        ? Url.Content("~/img/user.svg")
                        : Url.Content("~" + rutaFotoJoven);
                    string nombreJoven = ((joven.Nombre ?? "") + " " + (joven.Apellido ?? "")).Trim();
                    if (string.IsNullOrEmpty(nombreJoven))
                    {
                        nombreJoven = joven.Email ?? "Joven voluntario";
                    }

                    <div class="item-tarjeta-ayudado">
                        <div class="ayudado-info-usuario">
                            <img src="@srcJoven" alt="@nombreJoven" class="imagen-avatar-ayudado" />
                            <span class="nombre-usuario-ayudado">@nombreJoven</span>
                        </div>
                        <div class="ayudado-acciones">
                            <button type="button" class="button" onclick="verInfoAyudado(@joven.IdUsuario)">Ver más info</button>
                            <span class="posicion-ranking-numero">#@posicion</span>
                        </div>
                    </div>
                    posicion++;
                }
            }
            else
            {
                <div class="item-tarjeta-ayudado">
                    <span class="nombre-usuario-ayudado">Aún no se registran jóvenes en tu zona.</span>
                </div>
            }
        </div>

        <div id="contenedorDetalleFetch" class="detalle-fetch-card" style="display: none;">
            <h3 id="detalleNombre"></h3>
            <p id="detalleEmail"></p>
            <p id="detalleTelefono"></p>
            <p id="detalleTipo"></p>
        </div>
    </section>
</main>

