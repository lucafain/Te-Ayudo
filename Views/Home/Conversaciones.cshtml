@{
    ViewData["Title"] = "Conversaciones";
}

<header class="header">
    <a class="logo" href='@Url.Action("PrincipalAdulto", "Home")'>
        <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
    </a>

    <button class="menu-toggle"
            aria-expanded="false"
            aria-controls="navigation"
            aria-label="Abrir menú">
        ☰
    </button>

    <nav id="navigation" aria-label="Navegación principal">
        <a class="nav-button" href='@Url.Action("PrincipalAdulto", "Home")'>
            Inicio
        </a>

        <a class="nav-button nav-help" href='@Url.Action("SolicitarTarea", "Home")'>
            Solicita tus ayudas
        </a>

        <a class="nav-button login" href='@Url.Action("Perfil", "Home")'>
            <img class="login-icon" src="~/img/user.svg" alt="" />
            Mi cuenta
        </a>
    </nav>
</header>

<main class="conversations-page">
    <section class="messenger-shell" aria-label="Mensajería">
        <aside class="chat-list-panel">
            <div class="panel-header">
                <div class="panel-title-wrap">
                    <h2>Chats</h2>
                </div>
                <button class="icon-button" type="button" aria-label="Nuevo chat">＋</button>
            </div>

            <div class="search-box">
                <span class="search-icon">⌕</span>
                <input type="text" placeholder="Buscar" aria-label="Buscar conversaciones" />
            </div>

            <div class="conversation-list">
                <button type="button" class="conversation-item active">
                    <img src="~/img/user.svg" alt="María López" />
                    <div class="conversation-copy">
                        <div class="conversation-topline">
                            <strong>María López</strong>
                            <time>12:43</time>
                        </div>
                        <p>Perfecto, te paso la dirección y horario.</p>
                    </div>
                </button>

                <button type="button" class="conversation-item">
                    <img src="~/img/user.svg" alt="Lucas Gómez" />
                    <div class="conversation-copy">
                        <div class="conversation-topline">
                            <strong>Lucas Gómez</strong>
                            <time>10:20</time>
                        </div>
                        <p>Puedo ayudarte con las compras mañana.</p>
                    </div>
                </button>

                <button type="button" class="conversation-item">
                    <img src="~/img/user.svg" alt="Ana Ruiz" />
                    <div class="conversation-copy">
                        <div class="conversation-topline">
                            <strong>Ana Ruiz</strong>
                            <time>Ayer</time>
                        </div>
                        <p>Gracias por confirmar la visita.</p>
                    </div>
                </button>

                <button type="button" class="conversation-item">
                    <img src="~/img/user.svg" alt="Diego Torres" />
                    <div class="conversation-copy">
                        <div class="conversation-topline">
                            <strong>Diego Torres</strong>
                            <time>Lun</time>
                        </div>
                        <p>¿Qué día te conviene para la ayuda?</p>
                    </div>
                </button>

                <button type="button" class="conversation-item">
                    <img src="~/img/user.svg" alt="Cecilia Molina" />
                    <div class="conversation-copy">
                        <div class="conversation-topline">
                            <strong>Cecilia Molina</strong>
                            <time>Dom</time>
                        </div>
                        <p>Te dejo la lista en el chat.</p>
                    </div>
                </button>

                <button type="button" class="conversation-item">
                    <img src="~/img/user.svg" alt="Martín Silva" />
                    <div class="conversation-copy">
                        <div class="conversation-topline">
                            <strong>Martín Silva</strong>
                            <time>Vie</time>
                        </div>
                        <p>Todo bien con la entrega.</p>
                    </div>
                </button>
            </div>
        </aside>

        <section class="chat-panel">
            <header class="chat-header">
                <div class="contact-summary">
                    <img src="~/img/user.svg" alt="María López" />
                    <div>
                        <h3>María López</h3>
                        <span>En línea</span>
                    </div>
                </div>

                <div class="chat-tools">
                    <button class="icon-button" type="button" aria-label="Buscar en chat">⌕</button>
                    <button class="icon-button" type="button" aria-label="Silenciar">🔔</button>
                    <button class="icon-button" type="button" aria-label="Opciones">⋮</button>
                </div>
            </header>

            <div class="chat-body">
                <div class="day-marker">Hoy</div>

                <div class="message-row incoming">
                    <div class="bubble">
                        Hola, ¿cómo estás? Me gustaría confirmar la ayuda del domingo.
                    </div>
                    <span class="time">12:15</span>
                </div>

                <div class="message-row outgoing">
                    <div class="bubble">
                        ¡Perfecto! Ya quedó listo, puedo pasar a las 10:30.
                    </div>
                    <span class="time">12:18</span>
                </div>

                <div class="message-row incoming">
                    <div class="bubble">
                        Genial, muchas gracias. ¿Podés traer la lista de compras?
                    </div>
                    <span class="time">12:23</span>
                </div>

                <article class="link-card incoming-card">
                    <img src="~/img/logo-teayudo.png" alt="Preview de la tarea" />
                    <div class="link-card-body">
                        <span class="eyebrow">Tarea solicitada</span>
                        <h4>Lista de compras del hogar</h4>
                        <p>Mercado del barrio · 4 artículos · 30 min</p>
                        <a href="#">teayudo.com/ayuda/mercado</a>
                    </div>
                    <div class="emoji-reactions">
                        <span>👍</span>
                        <span>❤️</span>
                    </div>
                </article>

                <div class="message-row outgoing">
                    <div class="bubble">
                        Claro, te la paso en el chat y también la dirección exacta.
                    </div>
                    <span class="time">12:24</span>
                </div>

                <div class="message-row incoming">
                    <div class="bubble">
                        Perfecto, te paso la dirección y horario.
                    </div>
                    <span class="time">12:43</span>
                </div>
            </div>

            <form class="composer" method="post">
                <button type="button" class="emoji-button" aria-label="Agregar emoji">😊</button>
                <input type="text" placeholder="Escribí un mensaje" aria-label="Escribir mensaje" />
                <button type="submit" class="send-button">Enviar</button>
            </form>
        </section>
    </section>
</main>

<footer>
    <div class="footer-content page">
        <a class="logo" href='@Url.Action("Index", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <div>
            <h3>Te Ayudo</h3>
            <a href='@Url.Action("Index", "Home")#nosotros'>Nuestra historia</a>
            <a href='@Url.Action("Index", "Home")#valores'>Nuestros valores</a>
        </div>

        <div>
            <h3>Comunidad</h3>
            <a href='@Url.Action("PrincipalJoven", "Home")'>Mapa y comunidad</a>
            <a href='@Url.Action("Conversaciones", "Home")'>Conversaciones</a>
        </div>

        <div>
            <h3>Ayudas</h3>
            <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
            <a href='@Url.Action("PrincipalAdulto", "Home")'>Inicio</a>
        </div>

        <div>
            <h3>Mi cuenta</h3>
            <a href='@Url.Action("Perfil", "Home")'>Ver mi perfil</a>
            <a href='@Url.Action("CerrarSesion", "Home")'>Cerrar sesión</a>
        </div>
    </div>

    <p class="copyright">
        © <span id="year">2026</span> Te Ayudo.
        Todos los derechos reservados.
    </p>
</footer>
