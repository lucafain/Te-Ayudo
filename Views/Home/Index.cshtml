@{
    ViewData["Title"] = "Inicio";
}

<header class="header">
    <a class="logo" href='@Url.Action("Index", "Home")'>
        <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
    </a>

    <button class="menu-toggle"
            aria-expanded="false"
            aria-controls="navigation"
            aria-label="Abrir menú">
        ☰
    </button>

    <nav id="navigation" aria-label="Navegación principal">
       

        <a class="nav-button" href="#preguntas">
            Preguntas frecuentes
        </a>

        <a class="nav-button" href='@Url.Action("RegistroJoven", "Home")'>
            Trabajá con nosotros
        </a>

        <a class="nav-button nav-help" href='@Url.Action("RegistroMayor", "Home")'>
            Solicita tus ayudas
        </a>

        <a class="nav-button login" href='@Url.Action("Ingresar", "Home")'>
            <img class="login-icon" src="~/img/user.svg" alt="" />
            Iniciar sesión
        </a>
    </nav>
</header>

<section class="hero hero--inicio">
    <div class="hero-inicio-overlay">
        <div class="hero-inicio-content">
            <h1>@ViewBag.Titulo</h1>

            @foreach (string texto in ViewBag.Presentacion)
            {
                <p>@texto</p>
            }

            <div class="hero-inicio-cta">
                <a class="joven-btn-ayuda hero-inicio-btn" href='@Url.Action("RegistroMayor", "Home")'>
                    Unite a Te Ayudo
                </a>
            </div>
        </div>
    </div>
</section>

<main class="page" id="inicio">

    <section class="about panel" id="nosotros">
        <div class="about-logo">
            <img src="~/img/logo-teayudo.png"
                 alt="Te Ayudo, ayuda entre generaciones" />
        </div>

        <div class="about-copy">
            <h2>SOBRE NOSOTROS</h2>

            @foreach (string texto in ViewBag.SobreNosotros)
            {
                <p>@texto</p>
            }

            <p>
                <strong>Te Ayudo. @ViewBag.Titulo.</strong>
            </p>
        </div>
    </section>

    <section class="callout panel" id="adultos">
        <h2>@ViewBag.AyudaTitulo</h2>
        <p>@ViewBag.AyudaTexto</p>

        <a class="button" href='@Url.Action("RegistroMayor", "Home")'>
            Solicitar ayuda
        </a>
    </section>

    <section class="how panel" id="como-funciona">
        <h2>¿Cómo funciona?</h2>

        <div class="steps">
            @foreach (ContenidoItem paso in ViewBag.Pasos)
            {
                <article>
                    <h3>@paso.Titulo</h3>

                    <div class="icon-box">
                        <img src="@Url.Content("~/img/" + paso.Icono)"
                             alt="" />
                    </div>

                    <p>@paso.Texto</p>
                </article>
            }
        </div>

        <p class="ready">¡Y listo!</p>

        <a class="button" href='@Url.Action("RegistroMayor", "Home")'>
            Solicitar ayuda
        </a>
    </section>

    <section class="work panel" id="trabaja">
        <h2>@ViewBag.TrabajoTitulo</h2>
        <p>@ViewBag.TrabajoTexto</p>

        <a class="button" href='@Url.Action("RegistroJoven", "Home")'>
            Trabajá con nosotros
        </a>
    </section>

    <section class="values panel" id="valores">
        <h2>Lo que nos representa</h2>

        <div class="value-grid">
            @foreach (ContenidoItem valor in ViewBag.Valores)
            {
                <article>
                    <h3>@valor.Titulo</h3>

                    <div class="icon-box">
                        <img src="@Url.Content("~/img/" + valor.Icono)"
                             alt="" />
                    </div>

                    <p>@valor.Texto</p>
                </article>
            }
        </div>
    </section>

    <section class="faq panel" id="preguntas">
        <h2>Preguntas frecuentes</h2>

        @foreach (ContenidoItem pregunta in ViewBag.Preguntas)
        {
            <details>
                <summary>@pregunta.Titulo</summary>
                <p>@pregunta.Texto</p>
            </details>
        }
    </section>
</main>

<footer>
    <div class="footer-content page">
        <a class="logo" href='@Url.Action("Index", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <div>
            <h3>Te Ayudo</h3>
            <a href="#nosotros">Nuestra historia</a>
            <a href="#valores">Nuestros valores</a>
        </div>

        <div>
            <h3>Explorá</h3>
            <a href='@Url.Action("Explorar", "Home")'>Mapa y comunidad</a>
            <a href="#como-funciona">Cómo funciona</a>
            <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
        </div>

        <div>
            <h3>Trabajá con nosotros</h3>
            <a href="#trabaja">Conocé la propuesta</a>
            <a href='@Url.Action("RegistroJoven", "Home")'>
                Sumate
            </a>
        </div>

        <div>
            <h3>Ayuda</h3>
            <a href="#preguntas">Preguntas frecuentes</a>
            <a href='@Url.Action("Ingresar", "Home")'>
                Iniciar sesión
            </a>
        </div>
    </div>

    <p class="copyright">
        © <span id="year">2026</span> Te Ayudo.
        Todos los derechos reservados.
    </p>
</footer>
