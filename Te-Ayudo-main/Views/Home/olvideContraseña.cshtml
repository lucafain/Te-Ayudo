@{
    ViewData["Title"] = "Olvidé mi contraseña";
}

<main class="auth-page">
    <section class="auth-card auth-card--narrow">
        <h1 class="auth-title">Olvidé mi contraseña</h1>
        <div class="auth-divider"></div>

        <p class="auth-note">
            Ingresá tu correo electrónico para recuperar tu contraseña.
        </p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="auth-alert">@ViewBag.ErrorMessage</div>
        }

        <div id="mensajeErrorJs" class="auth-alert" style="display: none;"></div>

        <form action='@Url.Action("OlvideContrasena", "Home")' method="post" id="formOlvide">
            <div class="auth-grid" style="grid-template-columns: 1fr; gap: 16px;">
                <div class="field">
                    <label for="Email">Correo electrónico</label>
                    <input type="email" id="Email" name="Email" autocomplete="email" />
                </div>
            </div>

            <div class="auth-actions">
                <a class="auth-button auth-button--secondary" href='@Url.Action("Login", "Home")'>Volver</a>
                <button class="auth-button" type="submit">Buscar contraseña</button>
            </div>
        </form>
    </section>
</main>
