@model TeAyudo.Models.HomeViewModel

@{
    ViewData["Title"] = "Inicio";
}

<header class="header">
    <a class="logo" asp-controller="Home" asp-action="Index">
        <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
    </a>

    <button class="menu-toggle"
            aria-expanded="false"
            aria-controls="navigation"
            aria-label="Abrir menú">
        ☰
    </button>

    <nav id="navigation" aria-label="Navegación principal">
        <a class="nav-button" href="#como-funciona">
            Explorá
        </a>

        <a class="nav-button" href="#preguntas">
            Preguntas frecuentes
        </a>

        <a class="nav-button" href="#trabaja">
            Trabajá con nosotros
        </a>

        <a class="nav-button nav-help" href="#adultos">
            Solicita tus ayudas
        </a>

        <a class="nav-button login"
           asp-controller="Home"
           asp-action="Ingresar">
            <img class="login-icon" src="~/img/user.svg" alt="" />
            Iniciar sesión
        </a>
    </nav>
</header>

<main class="page" id="inicio">
    <section class="hero">
        <h1>@Model.Titulo</h1>

        <ul>
            @foreach (var texto in Model.Presentacion)
            {
                <li>@texto</li>
            }
        </ul>
    </section>

    <section class="about panel" id="nosotros">
        <div class="about-logo">
            <img src="~/img/logo-teayudo.png"
                 alt="Te Ayudo, ayuda entre generaciones" />
        </div>

        <div class="about-copy">
            <h2>SOBRE NOSOTROS</h2>

            @foreach (var texto in Model.SobreNosotros)
            {
                <p>@texto</p>
            }

            <p>
                <strong>Te Ayudo. @Model.Titulo.</strong>
            </p>
        </div>
    </section>

    <section class="callout panel" id="adultos">
        <h2>@Model.AyudaTitulo</h2>
        <p>@Model.AyudaTexto</p>

        <a class="button"
           asp-controller="Home"
           asp-action="RegistroMayor">
            Solicitar ayuda
        </a>
    </section>

    <section class="how panel" id="como-funciona">
        <h2>¿Cómo funciona?</h2>

        <div class="steps">
            @foreach (var paso in Model.Pasos)
            {
                <article>
                    <h3>@paso.Titulo</h3>

                    <div class="icon-box">
                        <img src="@Url.Content("~/img/" + paso.Icono)"
                             alt="" />
                    </div>

                    <p>@paso.Texto</p>
                </article>
            }
        </div>

        <p class="ready">¡Y listo!</p>

        <a class="button"
           asp-controller="Home"
           asp-action="RegistroMayor">
            Solicitar ayuda
        </a>
    </section>

    <section class="work panel" id="trabaja">
        <h2>@Model.TrabajoTitulo</h2>
        <p>@Model.TrabajoTexto</p>

        <a class="button"
           asp-controller="Home"
           asp-action="RegistroJoven">
            Trabajá con nosotros
        </a>
    </section>

    <section class="values panel" id="valores">
        <h2>Lo que nos representa</h2>

        <div class="value-grid">
            @foreach (var valor in Model.Valores)
            {
                <article>
                    <h3>@valor.Titulo</h3>

                    <div class="icon-box">
                        <img src="@Url.Content("~/img/" + valor.Icono)"
                             alt="" />
                    </div>

                    <p>@valor.Texto</p>
                </article>
            }
        </div>
    </section>

    <section class="faq panel" id="preguntas">
        <h2>Preguntas frecuentes</h2>

        @foreach (var pregunta in Model.Preguntas)
        {
            <details>
                <summary>@pregunta.Titulo</summary>
                <p>@pregunta.Texto</p>
            </details>
        }
    </section>
</main>

<footer>
    <div class="footer-content page">
        <a class="logo" asp-controller="Home" asp-action="Index">
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <div>
            <h3>Te Ayudo</h3>
            <a href="#nosotros">Nuestra historia</a>
            <a href="#valores">Nuestros valores</a>
        </div>

        <div>
            <h3>Explorá</h3>
            <a href="#como-funciona">Cómo funciona</a>
            <a href="#adultos">Solicita tus ayudas</a>
        </div>

        <div>
            <h3>Trabajá con nosotros</h3>
            <a href="#trabaja">Conocé la propuesta</a>
            <a asp-controller="Home" asp-action="RegistroJoven">
                Sumate
            </a>
        </div>

        <div>
            <h3>Ayuda</h3>
            <a href="#preguntas">Preguntas frecuentes</a>
            <a asp-controller="Home" asp-action="Ingresar">
                Iniciar sesión
            </a>
        </div>
    </div>

    <p class="copyright">
        © <span id="year">2026</span> Te Ayudo.
        Todos los derechos reservados.
    </p>
</footer>