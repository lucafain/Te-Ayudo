@{
    ViewData["Title"] = "Inicio Joven";
    string nombreJoven = ((ViewBag.Joven?.Nombre ?? "") + " " + (ViewBag.Joven?.Apellido ?? "")).Trim();
    if (string.IsNullOrEmpty(nombreJoven))
    {
        nombreJoven = ViewBag.Joven?.Email ?? "Usuario";
    }

    string rutaFotoNav = ((ViewBag.FotoPerfilSesion as string) ?? (ViewBag.Joven?.FotoPerfil as string) ?? "").Trim();
    bool tieneFotoPropia = !string.IsNullOrWhiteSpace(rutaFotoNav) && !rutaFotoNav.EndsWith("user.svg", StringComparison.OrdinalIgnoreCase);
    string srcFotoNav = tieneFotoPropia
        ? (rutaFotoNav.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? rutaFotoNav
            : Url.Content("~/" + rutaFotoNav.TrimStart('~', '/')))
        : Url.Content("~/img/user.svg");
}

<div class="joven-page">
    <header class="header header--joven">
        <a class="logo" href='@Url.Action("PrincipalJoven", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <button class="menu-toggle"
                aria-expanded="false"
                aria-controls="navigation"
                aria-label="Abrir menú">
            ☰
        </button>

        <nav id="navigation" aria-label="Navegación principal">
            <a class="nav-button nav-button--joven" href='@Url.Action("Explorar", "Home")'>
                Explorá
            </a>

            <a class="nav-button nav-button--joven" href="#ultimas-actividades">
                Conversaciones
            </a>

            <a class="nav-button nav-button--joven nav-button--joven-claro" href='@Url.Action("AyudasParaRealizar", "Home")'>
                Realizá Ayudas
            </a>

            <a class="nav-notif-btn" href="#ultimas-actividades" title="Notificaciones" aria-label="Notificaciones">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
            </a>

            <a class="nav-perfil-avatar" href='@Url.Action("Perfil", "Home")' title="Perfil" aria-label="Perfil">
                @if (tieneFotoPropia)
                {
                    <img src="@srcFotoNav" alt="Perfil" class="nav-perfil-foto" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                }
                <svg class="nav-perfil-svg" style="@(tieneFotoPropia ? "display:none;" : "")" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="14.5" r="7" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                    <path d="M7 38 C7 27.5 13 23.5 20 23.5 C27 23.5 33 27.5 33 38 Z" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                </svg>
            </a>
        </nav>
    </header>

    <section class="joven-hero">
        <div class="joven-hero-overlay">
            <div class="joven-hero-content">
                <h1>Hola, @nombreJoven</h1>
                <p>Dónde encontrás lo que buscás</p>
                <a class="joven-btn-ayuda" href='@Url.Action("AyudasParaRealizar", "Home")'>
                    Realizá una Ayuda
                </a>
            </div>
        </div>
    </section>

    <main class="joven-main">
        <section class="joven-seccion">
            <h2>¿Que necesitás hacer?</h2>

            <div class="joven-acciones-grid">
                <a class="joven-accion-item" href='@Url.Action("AyudasParaRealizar", "Home")'>
                    <div class="joven-accion-Verde">
                        <div class="joven-accion-Blanco">
                            <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#115e2e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="5" y="3" width="14" height="18" rx="2" ry="2"></rect>
                                <path d="M9 3h6v3H9z"></path>
                                <path d="M8 10l1.5 1.5L12 9"></path>
                                <line x1="14" y1="10" x2="16" y2="10"></line>
                                <path d="M8 15l1.5 1.5L12 14"></path>
                                <line x1="14" y1="15" x2="16" y2="15"></line>
                            </svg>
                        </div>
                    </div>
                    <p>Realiza una  <strong>Ayuda</strong></p>
                </a>

                <a class="joven-accion-item" href="#ultimas-actividades">
                    <div class="joven-accion-Verde">
                        <div class="joven-accion-Blanco">
                            <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="#115e2e">
                                <path d="M12 3C6.5 3 2 6.6 2 11c0 2.1 1 4.1 2.7 5.5L3.5 20l3.8-1.5c1.4.5 3 .8 4.7.8 5.5 0 10-3.6 10-8.3S17.5 3 12 3zm-4 9a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4zm4 0a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4zm4 0a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4z"/>
                            </svg>
                        </div>
                    </div>
                    <p>Ver <strong>conversaciones</strong></p>
                </a>

                <a class="joven-accion-item" href="#ultimas-actividades">
                    <div class="joven-accion-Verde">
                        <div class="joven-accion-Blanco">
                            <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="#115e2e">
                                <path d="M12 22c1.1 0 2-.9 2-2h-4a2 2 0 0 0 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/>
                            </svg>
                        </div>
                    </div>
                    <p>Ver <strong>notificaciones</strong></p>
                </a>
            </div>
        </section>

        <section class="joven-seccion">
            <h2>Consejos de trabajo</h2>

            <div class="joven-consejos-grid">
                <article class="joven-consejo-card">
                    <div class="joven-consejo-icono">
                        <svg xmlns="http://www.w3.org/2000/svg" width="90" height="90" viewBox="0 0 24 24" fill="#115e2e">
                            <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 11H8v-2h3V6h2v7z"/>
                        </svg>
                    </div>
                    <p>
                        La puntualidad es fundamental para los adultos. Procurá llegar 15 minutos antes de la hora de la tarea para recibir una mejor reseña y ser mejor valorado.
                    </p>
                </article>

                <article class="joven-consejo-card">
                    <div class="joven-consejo-icono">
                        <svg xmlns="http://www.w3.org/2000/svg" width="90" height="90" viewBox="0 0 24 24" fill="none" stroke="#115e2e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <p>
                        El respeto es primordial en nuestra comunidad. Recordá que esto busca que todos salgan beneficiados. Hagamos una comunidad mejor
                    </p>
                </article>

                <article class="joven-consejo-card">
                    <div class="joven-consejo-icono">
                        <svg xmlns="http://www.w3.org/2000/svg" width="90" height="90" viewBox="0 0 24 24" fill="none" stroke="#115e2e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                        </svg>
                    </div>
                    <p>
                        El aprendizaje es fundamental para ambas partes. Aprendé del adulto y que el adulto aprenda de vos. Todos aprendemos de los demás.
                    </p>
                </article>
            </div>
        </section>

        <section class="joven-seccion" id="ultimas-actividades">
            <h2>Ultimas actividades</h2>

            <div class="joven-actividades-caja">
                @{
                    List<Tareas>? tareasDisponibles = ViewBag.TareasDisponibles as List<Tareas>;
                    Dictionary<int, Usuarios>? solicitantes = ViewBag.Solicitantes as Dictionary<int, Usuarios>;
                }
                @if (tareasDisponibles != null && tareasDisponibles.Count > 0)
                {
                    foreach (Tareas tarea in tareasDisponibles)
                    {
                        DateTime fechaMostrar = tarea.DiaFecha.Year > 1 ? tarea.DiaFecha : (tarea.DiaTarea.Year > 1 ? tarea.DiaTarea : tarea.FechaCreacion);
                        Usuarios? adulto = (solicitantes != null && solicitantes.ContainsKey(tarea.IdUsuarioSolicitante))
                            ? solicitantes[tarea.IdUsuarioSolicitante]
                            : null;

                        string rutaFotoAdulto = adulto?.FotoPerfil ?? "";
                        string srcAdulto = string.IsNullOrEmpty(rutaFotoAdulto)
                            ? Url.Content("~/img/user.svg")
                            : Url.Content("~" + rutaFotoAdulto);

                        string nombreAdulto = adulto != null
                            ? ((adulto.Nombre ?? "") + " " + (adulto.Apellido ?? "")).Trim()
                            : "";
                        if (string.IsNullOrEmpty(nombreAdulto))
                        {
                            nombreAdulto = adulto?.Email ?? "Adulto mayor";
                        }

                        <div class="joven-actividad-fila" onclick="verInfoAyudado(@tarea.IdUsuarioSolicitante)">
                            <div class="joven-actividad-usuario">
                                <img src="@srcAdulto" alt="@nombreAdulto" class="joven-actividad-avatar" />
                                <span class="joven-actividad-nombre">@nombreAdulto</span>
                            </div>

                            <div class="joven-actividad-centro">
                                <p>Trabajo realizado: @tarea.Titulo</p>
                                <p>Precio: @(tarea.Monto)$</p>
                            </div>

                            <div class="joven-actividad-fecha">
                                <p>Fecha: @fechaMostrar.ToString("d/M/yy")</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="joven-actividad-fila">
                        <div class="joven-actividad-centro" style="width: 100%; text-align: center;">
                            <p>Aún no hay actividades registradas en la base de datos.</p>
                        </div>
                    </div>
                }
            </div>

            <div id="contenedorDetalleFetch" class="detalle-fetch-card" style="display: none;">
                <h3 id="detalleNombre"></h3>
                <p id="detalleEmail"></p>
                <p id="detalleTelefono"></p>
                <p id="detalleTipo"></p>
            </div>
        </section>
    </main>

    <footer>
        <div class="footer-content page">
            <a class="logo" href='@Url.Action("Index", "Home")'>
                <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
            </a>

            <div>
                <h3>Te Ayudo</h3>
                <a href='@Url.Action("Index", "Home")#nosotros'>Nuestra historia</a>
                <a href='@Url.Action("Index", "Home")#valores'>Nuestros valores</a>
            </div>

            <div>
                <h3>Explorá</h3>
                <a href='@Url.Action("Explorar", "Home")'>Mapa y comunidad</a>
                <a href='@Url.Action("Index", "Home")#como-funciona'>Cómo funciona</a>
                <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
            </div>

            <div>
                <h3>Trabajá con nosotros</h3>
                <a href='@Url.Action("Index", "Home")#trabaja'>Conocé la propuesta</a>
                <a href='@Url.Action("RegistroJoven", "Home")'>
                    Sumate
                </a>
            </div>

            <div>
                <h3>Ayuda</h3>
                <a href='@Url.Action("Index", "Home")#preguntas'>Preguntas frecuentes</a>
                <a href='@Url.Action("Perfil", "Home")'>
                    Mi cuenta
                </a>
            </div>
        </div>

        <p class="copyright">
            © <span id="year">2026</span> Te Ayudo.
            Todos los derechos reservados.
        </p>
    </footer>
</div>
