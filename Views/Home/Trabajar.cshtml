@{
    ViewData["Title"] = "Trabajá con nosotros";
}

<main class="auth-page">
    <section class="auth-card">
        <h1 class="auth-title">Trabajá con nosotros</h1>
        <div class="auth-divider"></div>

        <p class="auth-note">
            Este formulario es para jóvenes. Completá tus datos y subí tu foto de perfil para sumarte a la comunidad.
        </p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="auth-alert">@ViewBag.ErrorMessage</div>
        }

        <div id="mensajeErrorJs" class="auth-alert" style="display: none;"></div>

        <form action='@Url.Action("GuardarRegistroJoven", "Home")' method="post" enctype="multipart/form-data" id="formTrabajar">
            <div class="auth-grid">
                <div class="field">
                    <label for="Nombre">Nombre *</label>
                    <input type="text" id="Nombre" name="Nombre" autocomplete="given-name" />
                </div>

                <div class="field">
                    <label for="Apellido">Apellido *</label>
                    <input type="text" id="Apellido" name="Apellido" autocomplete="family-name" />
                </div>

                <div class="field">
                    <label for="Email">Correo electrónico *</label>
                    <input type="email" id="Email" name="Email" autocomplete="email" />
                </div>

                <div class="field">
                    <label for="Contrasena">Contraseña *</label>
                    <input type="password" id="Contrasena" name="Contrasena" autocomplete="new-password" />
                </div>

                <div class="field">
                    <label for="Provincia">Provincia *</label>
                    <input type="text" id="Provincia" name="Provincia" placeholder="Ej: Buenos Aires, CABA..." />
                </div>

                <div class="field">
                    <label for="Calle">Calle *</label>
                    <input type="text" id="Calle" name="Calle" placeholder="Ej: Av. Corrientes" />
                </div>

                <div class="field">
                    <label for="Direccion">Altura / Número *</label>
                    <input type="number" id="Direccion" name="Direccion" value="0" />
                </div>

                <div class="field">
                    <label for="CodigoPostal">Código postal *</label>
                    <input type="text" id="CodigoPostal" name="CodigoPostal" maxlength="8" />
                </div>

                <div class="field field--full upload-field">
                    <label for="FotoPerfil">Cargar foto de perfil</label>
                    <label class="upload-button" for="FotoPerfil" data-file-label="FotoPerfil">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="upload-icon">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                    </label>
                    <input type="file" id="FotoPerfil" name="FotoPerfil" accept="image/*" />
                    <span class="upload-filename" data-file-name="FotoPerfil">Ningún archivo seleccionado</span>
                </div>

                <div class="field field--full terms-check">
                    <label for="AceptaTerminos">
                        <input type="checkbox" id="AceptaTerminos" name="AceptaTerminos" value="true" />
                        <span>He leído y acepto los términos y condiciones.</span>
                    </label>
                </div>
            </div>

            <div class="auth-links">
                Ya tenés una cuenta? <a href='@Url.Action("Ingresar", "Home")'>Iniciar sesión</a>
            </div>

            <div class="auth-actions">
                <a class="auth-button auth-button--secondary" href='@Url.Action("Index", "Home")'>Volver al inicio</a>
                <button class="auth-button" type="submit">Aplicar</button>
            </div>
        </form>
    </section>
</main>
