@{
    ViewData["Title"] = "Explorá";
    Usuarios usuarioNav = ViewBag.Joven;
    bool esJovenNav = true;
    if (usuarioNav != null)
    {
        esJovenNav = usuarioNav.TipoUsuario;
    }

    int cantidadAyudas = 0;
    if (ViewBag.CantidadAyudas != null)
    {
        cantidadAyudas = ViewBag.CantidadAyudas;
    }

    string rutaFotoNav = "/img/user.svg";
    bool tieneFotoPropia = false;
    if (ViewBag.FotoPerfilSesion != null && ViewBag.FotoPerfilSesion != "" && ViewBag.FotoPerfilSesion != "/img/user.svg")
    {
        rutaFotoNav = ViewBag.FotoPerfilSesion;
        tieneFotoPropia = true;
    }

    string accionLogo = "PrincipalJoven";
    string linkPreguntas = Url.Action("Index", "Home") + "#preguntas";
    if (!esJovenNav)
    {
        accionLogo = "PrincipalAdulto";
        linkPreguntas = Url.Action("PrincipalAdulto", "Home") + "#preguntas-adulto";
    }
}

<header class="header header--joven">
    <a class="logo" href='@Url.Action(accionLogo, "Home")'>
        <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
    </a>

    <button class="menu-toggle"
            aria-expanded="false"
            aria-controls="navigation"
            aria-label="Abrir menú">
        ☰
    </button>

    <nav id="navigation" aria-label="Navegación principal">
        <a class="nav-button nav-button--joven" href='@Url.Action("Explorar", "Home")'>
            Explorá
        </a>

        <a class="nav-button" href='@linkPreguntas'>
            Preguntas frecuentes
        </a>

        @if (esJovenNav)
        {
            <a class="nav-button nav-help" href='@Url.Action("RealizarAyudas", "Home")' id="ExplorarAyuda">
                Realiza ayudas
            </a>
        }
        else
        {
            <a class="nav-button nav-help" href='@Url.Action("SolicitarTarea", "Home")' id="ExplorarAyuda">
                Solicitá ayudas
            </a>
        }

        <a class="nav-perfil-avatar" href='@Url.Action("Perfil", "Home")' title="Perfil" aria-label="Perfil">
            @if (tieneFotoPropia)
            {
                <img src="@rutaFotoNav" alt="Perfil" class="nav-perfil-foto" />
            }
            else
            {
                <svg class="nav-perfil-svg" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="14.5" r="7" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                    <path d="M7 38 C7 27.5 13 23.5 20 23.5 C27 23.5 33 27.5 33 38 Z" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                </svg>
            }
        </a>
    </nav>
</header>

<main class="page" id="explorar">
    <section class="panel seccion-explorar-mapa">
        <h2>Mapa de nuestra comunidad</h2>
        <div class="contenedor-mapa-zona">
            <iframe
                class="mapa-ubicacion-iframe"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13136.068307238214!2d-58.4418!3d-34.5912!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bcca0d6c4a5bb7%3A0x247a3e5c92c7d9c6!2sVilla%20Crespo%2C%20Buenos%20Aires!5e0!3m2!1ses!2sar!4v1700000000000"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>
    </section>

    <section class="panel seccion-historial-joven">
        <h2>Historial</h2>
        <div class="tarjeta-resumen-usuario">
            @{
                string srcJoven = "/img/user.svg";
                string nombreJoven = "Usuario de la comunidad";
                if (usuarioNav != null)
                {
                    if (usuarioNav.FotoPerfil != null && usuarioNav.FotoPerfil != "")
                    {
                        srcJoven = usuarioNav.FotoPerfil;
                    }
                    nombreJoven = usuarioNav.Nombre + " " + usuarioNav.Apellido;
                    if (nombreJoven.Replace(" ", "") == "")
                    {
                        nombreJoven = usuarioNav.Email;
                    }
                }
            }
            <img src="@srcJoven" alt="Foto Usuario" class="avatar-resumen-joven" />
            <div class="detalles-resumen-joven">
                <h3 class="nombre-resumen-joven">@nombreJoven</h3>
                @if (esJovenNav)
                {
                    <p class="conteo-ayudas-joven">@cantidadAyudas ayudas realizadas</p>
                }
                else
                {
                    <p class="conteo-ayudas-joven">@cantidadAyudas ayudas solicitadas</p>
                }
            </div>
        </div>
    </section>

    <section class="panel seccion-ultimos-ayudados">
        @if (esJovenNav)
        {
            <h2>Últimos ayudados</h2>
        }
        else
        {
            <h2>Personas que te ayudaron</h2>
        }
        <div class="contenedor-lista-ayudados">
            @{
                List<Usuarios> listaAyudados = ViewBag.UltimosAyudados;
            }
            @if (listaAyudados != null && listaAyudados.Count > 0)
            {
                int posicion = 1;
                foreach (Usuarios persona in listaAyudados)
                {
                    string srcPersona = "/img/user.svg";
                    if (persona.FotoPerfil != null && persona.FotoPerfil != "")
                    {
                        srcPersona = persona.FotoPerfil;
                    }

                    string nombrePersona = persona.Nombre + " " + persona.Apellido;
                    if (nombrePersona.Replace(" ", "") == "")
                    {
                        nombrePersona = persona.Email;
                    }

                    <div class="item-tarjeta-ayudado">
                        <div class="ayudado-info-usuario">
                            <img src="@srcPersona" alt="@nombrePersona" class="imagen-avatar-ayudado" />
                            <span class="nombre-usuario-ayudado">@nombrePersona</span>
                        </div>
                        <div class="ayudado-acciones">
                            <button type="button" class="button" onclick="verInfoAyudado(@persona.IdUsuario)">Ver más info</button>
                            <span class="posicion-ranking-numero">#@posicion</span>
                        </div>
                    </div>
                    posicion++;
                }
            }
            else
            {
                <div class="item-tarjeta-ayudado">
                    @if (esJovenNav)
                    {
                        <span class="nombre-usuario-ayudado">Aún no se registran adultos ayudados.</span>
                    }
                    else
                    {
                        <span class="nombre-usuario-ayudado">Aún no se registran personas que te hayan ayudado.</span>
                    }
                </div>
            }
        </div>

        <div id="contenedorDetalleFetch" class="detalle-fetch-card" style="display: none;">
            <h3 id="detalleNombre"></h3>
            <p id="detalleEmail"></p>
            <p id="detalleTelefono"></p>
            <p id="detalleTipo"></p>
        </div>
    </section>
</main>

<footer>
    <div class="footer-content page">
        <a class="logo" href='@Url.Action("Index", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <div>
            <h3>Te Ayudo</h3>
            <a href='@Url.Action("Index", "Home")#nosotros'>Nuestra historia</a>
            <a href='@Url.Action("Index", "Home")#valores'>Nuestros valores</a>
        </div>

        <div>
            <h3>Explorá</h3>
            <a href='@Url.Action("Explorar", "Home")'>Mapa y comunidad</a>
            <a href='@Url.Action("Index", "Home")#como-funciona'>Cómo funciona</a>
            <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
        </div>

        <div>
            <h3>Trabajá con nosotros</h3>
            <a href='@Url.Action("Index", "Home")#trabaja'>Conocé la propuesta</a>
            <a href='@Url.Action("RegistroJoven", "Home")'>
                Sumate
            </a>
        </div>

        <div>
            <h3>Ayuda</h3>
            <a href='@Url.Action("Index", "Home")#preguntas'>Preguntas frecuentes</a>
            <a href='@Url.Action("Ingresar", "Home")'>
                Iniciar sesión
            </a>
        </div>
    </div>

    <p class="copyright">
        © <span id="year">2026</span> Te Ayudo.
        Todos los derechos reservados.
    </p>
</footer>
