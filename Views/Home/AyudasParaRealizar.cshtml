@{
    ViewData["Title"] = "Ayudas para realizar";
    List<Tareas>? tareasPendientes = ViewBag.TareasPendientes as List<Tareas>;
    Dictionary<int, int>? distanciasTareas = ViewBag.DistanciasTareas as Dictionary<int, int>;
    Dictionary<int, string>? estadosPostulacion = ViewBag.EstadosPostulacion as Dictionary<int, string>;
    Usuarios? jovenActual = ViewBag.Joven as Usuarios;

    string rutaFotoNav = ((ViewBag.FotoPerfilSesion as string) ?? (jovenActual?.FotoPerfil as string) ?? "").Trim();
    bool tieneFotoPropia = !string.IsNullOrWhiteSpace(rutaFotoNav) && !rutaFotoNav.EndsWith("user.svg", StringComparison.OrdinalIgnoreCase);
    string srcFotoNav = tieneFotoPropia
        ? (rutaFotoNav.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? rutaFotoNav
            : Url.Content("~/" + rutaFotoNav.TrimStart('~', '/')))
        : Url.Content("~/img/user.svg");
}

<div class="joven-page">
    <header class="header header--joven">
        <a class="logo" href='@Url.Action("PrincipalJoven", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <button class="menu-toggle"
                aria-expanded="false"
                aria-controls="navigation"
                aria-label="Abrir menú">
            ☰
        </button>

        <nav id="navigation" aria-label="Navegación principal">
            <a class="nav-button nav-button--joven" href='@Url.Action("Explorar", "Home")'>
                Explorá
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("PrincipalJoven", "Home")#ultimas-actividades'>
                Conversaciones
            </a>

            <a class="nav-button nav-button--joven nav-button--joven-claro" href='@Url.Action("AyudasParaRealizar", "Home")'>
                Realizá Ayudas
            </a>

            <a class="nav-notif-btn" href='@Url.Action("PrincipalJoven", "Home")#ultimas-actividades' title="Notificaciones" aria-label="Notificaciones">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
            </a>

            <a class="nav-perfil-avatar" href='@Url.Action("Perfil", "Home")' title="Perfil" aria-label="Perfil">
                @if (tieneFotoPropia)
                {
                    <img src="@srcFotoNav" alt="Perfil" class="nav-perfil-foto" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                }
                <svg class="nav-perfil-svg" style="@(tieneFotoPropia ? "display:none;" : "")" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="14.5" r="7" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                    <path d="M7 38 C7 27.5 13 23.5 20 23.5 C27 23.5 33 27.5 33 38 Z" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                </svg>
            </a>
        </nav>
    </header>

    <main class="joven-main">
        <!-- VISTA 1: GRILLA DE AYUDAS PARA REALIZAR -->
        <section class="joven-seccion" id="vistaGrillaAyudas">
            <h1 class="ayudas-titulo-principal">Ayudas para realizar</h1>

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="auth-alert" style="max-width: 520px; margin: 0 auto 24px; background: #ffffff; color: #0d6e2b;">
                    @ViewBag.SuccessMessage
                </div>
            }

            @if (tareasPendientes != null && tareasPendientes.Count > 0)
            {
                <div class="ayudas-grid">
                    @foreach (Tareas tarea in tareasPendientes)
                    {
                        string montoMostrar = tarea.Monto > 0 ? tarea.Monto.ToString("0") : "5000";
                        string direccionMostrar = !string.IsNullOrWhiteSpace(tarea.Lugar)
                            ? tarea.Lugar
                            : (!string.IsNullOrWhiteSpace(tarea.Barrio) ? tarea.Barrio : "CABA");
                        int kmAprox = (distanciasTareas != null && distanciasTareas.ContainsKey(tarea.IdTarea))
                            ? distanciasTareas[tarea.IdTarea]
                            : 2;
                        string estadoPost = (estadosPostulacion != null && estadosPostulacion.ContainsKey(tarea.IdTarea))
                            ? estadosPostulacion[tarea.IdTarea]
                            : "";

                        if (estadoPost == "Aceptada")
                        {
                            <article class="ayuda-card ayuda-card--aceptada" id="card-tarea-@tarea.IdTarea">
                                <div class="ayuda-card-top ayuda-card-top--aceptada">
                                    <span class="ayuda-card-monto ayuda-card-monto--blanco">$@montoMostrar</span>
                                    <span class="ayuda-card-dot-blanco" aria-hidden="true"></span>
                                </div>

                                <div class="ayuda-card-body">
                                    <h3>@tarea.Titulo</h3>

                                    <p class="ayuda-card-subtitulo-aceptada">La tarea fue Aceptada</p>

                                    <div class="ayuda-card-botones">
                                        <button type="button" class="btn-ayuda-verde btn-ayuda-accion-unica" onclick="abrirDetalleTareaAceptadaFetch(@tarea.IdTarea)">
                                            Ver más
                                        </button>
                                    </div>

                                    <div class="ayuda-card-ubicacion">
                                        <span class="ayuda-card-direccion">@direccionMostrar</span>
                                        <span class="ayuda-card-distancia">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                                <circle cx="12" cy="10" r="3"></circle>
                                            </svg>
                                            A @(kmAprox)km de ti
                                        </span>
                                    </div>
                                </div>
                            </article>
                        }
                        else if (estadoPost == "Rechazada")
                        {
                            <article class="ayuda-card ayuda-card--rechazada" id="card-tarea-@tarea.IdTarea">
                                <div class="ayuda-card-top ayuda-card-top--rechazada">
                                    <span class="ayuda-card-monto ayuda-card-monto--blanco">$@montoMostrar</span>
                                </div>

                                <div class="ayuda-card-body">
                                    <h3>@tarea.Titulo</h3>

                                    <p class="ayuda-card-subtitulo-rechazada">No fuiste seleccionado para la tarea</p>

                                    <div class="ayuda-card-botones">
                                        <button type="button" class="btn-ayuda-rojo btn-ayuda-accion-unica" onclick="eliminarTareaRechazadaFetch(@tarea.IdTarea)">
                                            Eliminar
                                        </button>
                                    </div>

                                    <div class="ayuda-card-ubicacion">
                                        <span class="ayuda-card-direccion">@direccionMostrar</span>
                                        <span class="ayuda-card-distancia">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                                <circle cx="12" cy="10" r="3"></circle>
                                            </svg>
                                            A @(kmAprox)km de ti
                                        </span>
                                    </div>
                                </div>
                            </article>
                        }
                        else
                        {
                            <article class="ayuda-card" id="card-tarea-@tarea.IdTarea">
                                <div class="ayuda-card-top">
                                    <span class="ayuda-card-monto">$@montoMostrar</span>
                                </div>

                                <div class="ayuda-card-body">
                                    <h3>@tarea.Titulo</h3>

                                    <div class="ayuda-card-botones">
                                        <button type="button" class="btn-ayuda-verde" onclick="abrirDetalleTareaFetch(@tarea.IdTarea)">
                                            Ver más
                                        </button>

                                        <button type="button" class="btn-ayuda-rojo" onclick="rechazarTareaConUndo(@tarea.IdTarea)">
                                            Rechazar
                                        </button>
                                    </div>

                                    <div class="ayuda-card-ubicacion">
                                        <span class="ayuda-card-direccion">@direccionMostrar</span>
                                        <span class="ayuda-card-distancia">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                                <circle cx="12" cy="10" r="3"></circle>
                                            </svg>
                                            A @(kmAprox)km de ti
                                        </span>
                                    </div>
                                </div>
                            </article>
                        }
                    }
                </div>
            }
            else
            {
                <div class="joven-actividades-caja" style="max-width: 560px; margin: 0 auto;">
                    <div class="joven-actividad-fila" style="justify-content: center;">
                        <p>No hay ayudas pendientes para realizar en este momento.</p>
                    </div>
                </div>
            }
        </section>

        <!-- VISTA 2: DETALLE DE LA AYUDA DISPONIBLE (CARGADA CON FETCH) -->
        <section class="detalle-ayuda-contenedor" id="vistaDetalleAyuda" style="display: none;">
            <div class="detalle-ayuda-card">
                <img id="detalleTareaFoto" src="~/img/user.svg" alt="Solicitante" class="detalle-ayuda-foto" />

                <div class="detalle-ayuda-info">
                    <h1 id="detalleTareaSolicitante" class="detalle-ayuda-nombre">Adulto mayor</h1>

                    <p id="detalleTareaTitulo" class="detalle-ayuda-linea"></p>
                    <p id="detalleTareaLugar" class="detalle-ayuda-linea"></p>
                    <p id="detalleTareaFechaHora" class="detalle-ayuda-linea"></p>
                    <p id="detalleTareaDescripcion" class="detalle-ayuda-descripcion"></p>

                    <div class="detalle-ayuda-botones">
                        <button type="button" class="btn-detalle-cancelar" onclick="volverAGrillaAyudas()">
                            Cancelar
                        </button>

                        <button type="button" id="btnPostularmeDetalle" class="btn-detalle-postular" onclick="postularmeConFetch()">
                            Postularme ahora
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- VISTA 2B: DETALLE DE LA AYUDA ACEPTADA (CARGADA CON FETCH) -->
        <section class="detalle-aceptada-contenedor" id="vistaDetalleAceptada" style="display: none;">
            <div class="detalle-aceptada-wrapper">
                <div class="detalle-aceptada-card">
                    <div class="detalle-aceptada-top">
                        <span id="detalleAceptadaMonto" class="detalle-aceptada-monto">$5000</span>
                    </div>

                    <div class="detalle-aceptada-body">
                        <img id="detalleAceptadaFoto" src="~/img/user.svg" alt="Solicitante" class="detalle-aceptada-foto" />

                        <div class="detalle-aceptada-info">
                            <h2 id="detalleAceptadaSolicitante" class="detalle-aceptada-nombre">Adulto mayor</h2>

                            <p id="detalleAceptadaTitulo" class="detalle-aceptada-linea"></p>
                            <p id="detalleAceptadaLugar" class="detalle-aceptada-linea"></p>
                            <p id="detalleAceptadaFechaHora" class="detalle-aceptada-linea"></p>
                            <p id="detalleAceptadaDescripcion" class="detalle-aceptada-descripcion"></p>

                            <div class="detalle-aceptada-botones">
                                <button type="button" class="btn-finalizar-tarea" onclick="finalizarTareaAceptadaFetch()">
                                    Finalizar Tarea
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- VISTA 3: POSTULADOS A LA AYUDA (CARGADA CON FETCH) -->
        <section class="postulados-contenedor" id="vistaPostuladosAyuda" style="display: none;">
            <h1 class="postulados-titulo" id="postuladosTituloTexto">¡Ya estás postulado!</h1>

            <div class="postulados-grid" id="grillaPostuladosFetch"></div>

            <div id="contenedorDetalleFetch" class="detalle-fetch-card" style="display: none;">
                <h3 id="detalleNombre"></h3>
                <p id="detalleEmail"></p>
                <p id="detalleTelefono"></p>
                <p id="detalleTipo"></p>
            </div>

            <div style="text-align: center; margin-top: 28px;">
                <button type="button" class="btn-ayuda-verde" onclick="volverAGrillaAyudas()">
                    Volver a ayudas para realizar
                </button>
            </div>
        </section>

        <!-- SNACKBAR PARA DESHACER RECHAZO -->
        <div id="snackbarRechazo" class="snackbar-rechazo" style="display: none;" role="status" aria-live="polite">
            <span id="snackbarTexto">Rechazaste esta ayuda.</span>
            <button type="button" class="snackbar-btn-deshacer" onclick="deshacerRechazoTarea()">
                Deshacer
            </button>
        </div>
    </main>

    <footer>
        <div class="footer-content page">
            <a class="logo" href='@Url.Action("Index", "Home")'>
                <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
            </a>

            <div>
                <h3>Te Ayudo</h3>
                <a href='@Url.Action("Index", "Home")#nosotros'>Nuestra historia</a>
                <a href='@Url.Action("Index", "Home")#valores'>Nuestros valores</a>
            </div>

            <div>
                <h3>Explorá</h3>
                <a href='@Url.Action("Explorar", "Home")'>Mapa y comunidad</a>
                <a href='@Url.Action("Index", "Home")#como-funciona'>Cómo funciona</a>
                <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
            </div>

            <div>
                <h3>Trabajá con nosotros</h3>
                <a href='@Url.Action("Index", "Home")#trabaja'>Conocé la propuesta</a>
                <a href='@Url.Action("RegistroJoven", "Home")'>
                    Sumate
                </a>
            </div>

            <div>
                <h3>Ayuda</h3>
                <a href='@Url.Action("Index", "Home")#preguntas'>Preguntas frecuentes</a>
                <a href='@Url.Action("Perfil", "Home")'>
                    Mi cuenta
                </a>
            </div>
        </div>

        <p class="copyright">
            © <span id="year">2026</span> Te Ayudo.
            Todos los derechos reservados.
        </p>
    </footer>
</div>
