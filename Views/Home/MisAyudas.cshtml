@{
    ViewData["Title"] = "Ayudas pedidas";
    List<Tareas>? misTareas = ViewBag.MisTareas as List<Tareas>;
    Dictionary<int, int>? cantidadPostulantes = ViewBag.CantidadPostulantes as Dictionary<int, int>;
    Dictionary<int, Usuarios?>? jovenesAsignados = ViewBag.JovenesAsignados as Dictionary<int, Usuarios?>;
    Dictionary<int, bool>? tareasFinalizadas = ViewBag.TareasFinalizadas as Dictionary<int, bool>;

    string rutaFotoNav = ((ViewBag.FotoPerfilSesion as string) ?? (ViewBag.Adulto?.FotoPerfil as string) ?? "").Trim();
    bool tieneFotoPropia = !string.IsNullOrWhiteSpace(rutaFotoNav) && !rutaFotoNav.EndsWith("user.svg", StringComparison.OrdinalIgnoreCase);
    string srcFotoNav = tieneFotoPropia
        ? (rutaFotoNav.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? rutaFotoNav
            : Url.Content("~/" + rutaFotoNav.TrimStart('~', '/')))
        : Url.Content("~/img/user.svg");
}

<div class="joven-page">
    <header class="header header--joven">
        <a class="logo" href='@Url.Action("PrincipalAdulto", "Home")'>
            <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
        </a>

        <button class="menu-toggle"
                aria-expanded="false"
                aria-controls="navigation"
                aria-label="Abrir menú">
            ☰
        </button>

        <nav id="navigation" aria-label="Navegación principal">
            <a class="nav-button nav-button--joven" href='@Url.Action("Explorar", "Home")'>
                Explorá
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("PrincipalAdulto", "Home")#preguntas-adulto'>
                Preguntas frecuentes
            </a>

            <a class="nav-button nav-button--joven" href='@Url.Action("SolicitarTarea", "Home")'>
                Solicitá ayudas
            </a>

            <a class="nav-perfil-avatar" href='@Url.Action("Perfil", "Home")' title="Perfil" aria-label="Perfil">
                @if (tieneFotoPropia)
                {
                    <img src="@srcFotoNav" alt="Perfil" class="nav-perfil-foto" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                }
                <svg class="nav-perfil-svg" style="@(tieneFotoPropia ? "display:none;" : "")" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="14.5" r="7" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                    <path d="M7 38 C7 27.5 13 23.5 20 23.5 C27 23.5 33 27.5 33 38 Z" fill="#ffffff" stroke="#233645" stroke-width="2.5"/>
                </svg>
            </a>
        </nav>
    </header>

    <main class="joven-main">
        <section class="joven-seccion">
            <h1 class="ayudas-titulo-principal">Ayudas pedidas</h1>

            <div style="margin-top: 36px; margin-bottom: 36px;">
                <a class="btn-nueva-ayuda" href='@Url.Action("SolicitarTarea", "Home")'>
                    Pedí una nueva Ayuda
                </a>
            </div>


            @if (ViewBag.SuccessMessage != null)
            {
                <div class="auth-alert" style="max-width: 520px; margin: 0 auto 24px; background: #ffffff; color: #0d6e2b;">
                    @ViewBag.SuccessMessage
                </div>
            }

            @if (misTareas != null && misTareas.Count > 0)
            {
                <div class="ayudas-grid">
                    @foreach (Tareas tarea in misTareas)
                    {
                        int postulantes = 0;
                        if (cantidadPostulantes != null && cantidadPostulantes.ContainsKey(tarea.IdTarea))
                        {
                            postulantes = cantidadPostulantes[tarea.IdTarea];
                        }

                        Usuarios? jovenAsignado = null;
                        if (jovenesAsignados != null && jovenesAsignados.ContainsKey(tarea.IdTarea))
                        {
                            jovenAsignado = jovenesAsignados[tarea.IdTarea];
                        }

                        bool esFinalizada = tareasFinalizadas != null && tareasFinalizadas.ContainsKey(tarea.IdTarea) && tareasFinalizadas[tarea.IdTarea];

                        if (esFinalizada)
                        {
                            <article class="ayuda-card ayuda-card--aceptada">
                                <div class="ayuda-card-top ayuda-card-top--aceptada"></div>

                                <div class="ayuda-card-body">
                                    <h3>@tarea.Titulo</h3>

                                    <p class="ayuda-card-subtitulo-aceptada">Tarea finalizada</p>

                                    <div class="ayuda-card-botones">
                                        <a class="btn-ayuda-verde btn-ayuda-accion-unica" href='@Url.Action("TicketAyuda", "Home", new { idTarea = tarea.IdTarea })'>
                                            Ver detalle
                                        </a>

                                        <form action='@Url.Action("EliminarTareaFinalizada", "Home")' method="post" style="display: inline;">
                                            <input type="hidden" name="idTarea" value="@tarea.IdTarea" />
                                            <button type="submit" class="btn-ayuda-verde btn-ayuda-accion-unica">
                                                Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </article>
                        }
                        else
                        {
                            <article class="ayuda-card">
                                <div class="ayuda-card-top"></div>

                                <div class="ayuda-card-body">
                                    <h3>@tarea.Titulo</h3>
                                    @if (jovenAsignado != null)
                                    {
                                        string nombreAsignado = ((jovenAsignado.Nombre ?? "") + " " + (jovenAsignado.Apellido ?? "")).Trim();
                                        if (string.IsNullOrEmpty(nombreAsignado))
                                        {
                                            nombreAsignado = jovenAsignado.Email;
                                        }
                                        <p class="ayuda-card-postulantes" style="color: #0d6e2b; font-weight: 600;">
                                            Realiza: @nombreAsignado
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="ayuda-card-postulantes">
                                            @postulantes @(postulantes == 1 ? "postulante" : "postulantes")
                                        </p>
                                    }

                                    <div class="ayuda-card-botones">
                                        <a class="btn-ayuda-verde" href='@Url.Action("PostulantesTarea", "Home", new { idTarea = tarea.IdTarea })'>
                                            Ver más
                                        </a>

                                        @if (postulantes == 0 && jovenAsignado == null && tarea.Estado)
                                        {
                                            <a class="btn-ayuda-verde" href='@Url.Action("ModificarTarea", "Home", new { idTarea = tarea.IdTarea })'>
                                                Modificar
                                            </a>

                                            <form action='@Url.Action("CancelarTarea", "Home")' method="post" style="display: inline;">
                                                <input type="hidden" name="idTarea" value="@tarea.IdTarea" />
                                                <button type="submit" class="btn-ayuda-rojo">Cancelar</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn-ayuda-deshabilitado" disabled title="No se puede modificar porque ya tiene postulantes o aceptados">
                                                Modificar
                                            </button>

                                            <button type="button" class="btn-ayuda-deshabilitado" disabled title="No se puede cancelar porque ya tiene postulantes">
                                                Cancelar
                                            </button>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    }
                </div>
            }
            else
            {
                <div class="joven-actividades-caja" style="max-width: 560px; margin: 0 auto;">
                    <div class="joven-actividad-fila" style="justify-content: center;">
                        <p>Todavía no pediste ninguna ayuda.</p>
                    </div>
                </div>
            }

            
        </section>
    </main>

    <footer>
        <div class="footer-content page">
            <a class="logo" href='@Url.Action("Index", "Home")'>
                <img src="~/img/logo-teayudo.png" alt="Te Ayudo" />
            </a>

            <div>
                <h3>Te Ayudo</h3>
                <a href='@Url.Action("Index", "Home")#nosotros'>Nuestra historia</a>
                <a href='@Url.Action("Index", "Home")#valores'>Nuestros valores</a>
            </div>

            <div>
                <h3>Ayudas</h3>
                <a href='@Url.Action("SolicitarTarea", "Home")'>Solicita tus ayudas</a>
                <a href='@Url.Action("MisAyudas", "Home")'>Ayudas pedidas</a>
            </div>

            <div>
                <h3>Comunidad</h3>
                <a href='@Url.Action("Explorar", "Home")'>Mapa y comunidad</a>
            </div>

            <div>
                <h3>Mi cuenta</h3>
                <a href='@Url.Action("Perfil", "Home")'>Ver mi perfil</a>
                <a href='@Url.Action("CerrarSesion", "Home")'>Cerrar sesión</a>
            </div>
        </div>

        <p class="copyright">
            © <span id="year">2026</span> Te Ayudo.
            Todos los derechos reservados.
        </p>
    </footer>
</div>
